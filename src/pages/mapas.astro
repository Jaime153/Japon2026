---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getDayAlternatives, isoDate } from '../lib/segments';

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order);

const routes = segments.flatMap((segment) =>
  segment.data.days.map((day) => {
    const mainStops = day.routeStops?.length
      ? day.routeStops.map((stop, index) => ({
          id: `route-stop-${index}`,
          title: stop.title,
          query: stop.locationQuery,
          category: 'otro',
          time: '',
          tabelog: '',
          mapcode: stop.mapcode ?? '',
          mapcodeKind: stop.mapcodeKind ?? '',
          note: stop.note ?? '',
          spotQuery: stop.spotQuery ?? '',
        }))
      : day.activities
          .filter((activity) => activity.locationQuery || activity.address)
          .map((activity) => ({
            id: activity.id,
            title: activity.title,
            query: activity.locationQuery ?? activity.address ?? activity.title,
            category: activity.category,
            time: activity.time ?? '',
            tabelog: activity.links?.tabelog ?? '',
            mapcode: activity.parking?.mapcode ?? '',
            mapcodeKind: activity.parking?.kind ?? '',
            note: activity.parking?.name ?? '',
            spotQuery: activity.parking?.spotQuery ?? '',
          }));

    const alternatives = getDayAlternatives(segment.data, day.date).map((alternative) => ({
      id: alternative.id,
      label: alternative.switchLabel ?? alternative.title,
      stops: alternative.activities
        .filter((activity) => activity.locationQuery || activity.address)
        .map((activity) => ({
          id: activity.id,
          title: activity.title,
          query: activity.locationQuery ?? activity.address ?? activity.title,
          category: activity.category,
          time: activity.time ?? '',
          tabelog: activity.links?.tabelog ?? '',
          mapcode: activity.parking?.mapcode ?? '',
          mapcodeKind: activity.parking?.kind ?? '',
          note: activity.parking?.name ?? '',
          spotQuery: activity.parking?.spotQuery ?? '',
        })),
    }));

    const date = isoDate(day.date);
    const isFujiDay = date === '2026-10-09';

    return {
      date,
      city: segment.data.legLabel ?? segment.data.city,
      title: day.title ?? segment.data.city,
      mainLabel: day.switchLabel ?? 'Plan',
      routingMode: isFujiDay ? 'car' : 'foot',
      variants: [{ id: 'main', label: day.switchLabel ?? 'Plan', stops: mainStops }, ...alternatives],
    };
  }),
).filter((route) => route.variants.some((variant) => variant.stops.length > 0));

const placeMap = new Map<string, { title: string; query: string; city: string; firstDate: string; category: string; tabelog: string }>();

function addPlace(place: { title: string; query: string; city: string; firstDate: string; category: string; tabelog?: string }) {
  const key = place.query.toLocaleLowerCase();
  if (!placeMap.has(key)) {
    placeMap.set(key, { ...place, tabelog: place.tabelog ?? '' });
  }
}

for (const segment of segments) {
  const city = segment.data.legLabel ?? segment.data.city;

  for (const day of segment.data.days) {
    const firstDate = isoDate(day.date);

    for (const activity of day.activities) {
      const query = activity.locationQuery ?? activity.address;
      if (!query) continue;
      addPlace({
        title: activity.title,
        query,
        city,
        firstDate,
        category: activity.category,
        tabelog: activity.links?.tabelog,
      });
    }

    for (const stop of day.routeStops ?? []) {
      addPlace({
        title: stop.title,
        query: stop.locationQuery,
        city,
        firstDate,
        category: 'otro',
      });
    }
  }

  for (const candidate of segment.data.candidateModules) {
    if (!candidate.forDate) continue;
    const firstDate = isoDate(candidate.forDate);
    for (const activity of candidate.activities) {
      const query = activity.locationQuery ?? activity.address;
      if (!query) continue;
      addPlace({
        title: activity.title,
        query,
        city,
        firstDate,
        category: activity.category,
        tabelog: activity.links?.tabelog,
      });
    }
  }
}

const places = [...placeMap.values()].sort((a, b) => a.firstDate.localeCompare(b.firstDate) || a.title.localeCompare(b.title, 'es'));
---

<Layout title="Ruta · Japón 2026">
  <header class="mb-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Nuestra lista canónica</p>
    <h1 class="text-3xl font-black tracking-tight">Ruta Japón 2026</h1>
    <p class="mt-2 text-sm leading-relaxed text-slate-500">
      Solo aparecen lugares de nuestro planning. Las listas de terceros ya no alimentan el mapa principal.
    </p>
  </header>

  <a href={import.meta.env.BASE_URL + "fotos-tokyo-tower/"} class="mb-5 flex items-center justify-between gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 shadow-sm">
    <div><p class="text-xs font-black uppercase tracking-wide text-red-700">📸 TikTok · Tokyo Tower</p><p class="mt-1 font-black text-slate-950">Los 8 spots de fotos, con mapa y coordenadas</p><p class="mt-1 text-xs text-slate-600">Incluye las famosas escaleras y enlaces para llegar andando.</p></div>
    <span class="shrink-0 text-xl text-red-700">→</span>
  </a>

  <section class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex gap-2 overflow-x-auto pb-2" id="route-days">
      {routes.map((route, index) => (
        <button
          type="button"
          class="route-day shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700"
          data-route-index={index}
        >
          {new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(route.date + 'T00:00:00Z'))}
        </button>
      ))}
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p id="route-city" class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400"></p>
        <h2 id="route-title" class="text-xl font-black"></h2>
      </div>
      <button id="locate-me" type="button" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700">◎ Estoy aquí</button>
    </div>

    <div id="route-variants" class="mt-3 hidden gap-2"></div>

    <div id="route-map-status" class="mt-3 rounded-xl bg-slate-100 px-3 py-2 text-xs text-slate-600">
      Preparando mapa…
    </div>

    <div id="trip-route-map" class="mt-3 h-[48vh] min-h-[360px] overflow-hidden rounded-2xl bg-slate-100"></div>

    <div class="mt-3 flex flex-wrap gap-2">
      <a id="open-google-route" href="#" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-slate-950 px-4 py-3 text-sm font-bold text-white">
        🧭 Abrir ruta real en Google Maps
      </a>
      <span class="self-center text-xs text-slate-400">La web intenta seguir calles/carreteras; Google Maps queda como navegación final en tiempo real.</span>
    </div>

    <ol id="route-stops" class="mt-5 grid gap-2"></ol>
  </section>

  <section class="mt-8">
    <div class="mb-3 flex items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Guardado en nuestro planning</p>
        <h2 class="text-2xl font-black">Lugares Japón 2026</h2>
      </div>
      <span class="text-xs text-slate-400">{places.length} lugares</span>
    </div>

    <div class="sticky top-14 z-20 mb-4 rounded-2xl border border-slate-200 bg-slate-50/95 p-3 backdrop-blur">
      <input id="place-search" type="search" placeholder="Buscar Cattlea, Sensō-ji, Katsuo-ji…" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-3 text-base outline-none focus:border-slate-400" />
      <button id="export-places" type="button" class="mt-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700">⬇️ Exportar lugares CSV</button>
    </div>

    <div id="our-places" class="grid gap-2 sm:grid-cols-2">
      {places.map((place) => {
        const google = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.query)}`;
        const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(place.query)}`;
        return (
          <article class="our-place rounded-2xl border border-slate-200 bg-white p-3 shadow-sm" data-search={`${place.title} ${place.city} ${place.query}`.toLocaleLowerCase()}>
            <p class="text-[11px] font-bold uppercase tracking-wide text-slate-400">{place.firstDate} · {place.city}</p>
            <h3 class="mt-1 font-black text-slate-950">{place.title}</h3>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href={google} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-blue-50 px-2.5 py-2 text-xs font-bold text-blue-800">📍 Maps</a>
              <a href={directions} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-emerald-50 px-2.5 py-2 text-xs font-bold text-emerald-800">🧭 Ir</a>
              {place.tabelog && <a href={place.tabelog} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-orange-50 px-2.5 py-2 text-xs font-bold text-orange-800">🍽️ Tabelog</a>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <script is:inline define:vars={{ routes, places }}>
    let map;
    let routeLayer;
    let currentRoute = 0;
    let currentVariant = 'main';
    let userMarker;

    const statusEl = document.querySelector('#route-map-status');
    const titleEl = document.querySelector('#route-title');
    const cityEl = document.querySelector('#route-city');
    const stopsEl = document.querySelector('#route-stops');
    const googleRouteEl = document.querySelector('#open-google-route');
    const variantEl = document.querySelector('#route-variants');
    const dayButtons = [...document.querySelectorAll('.route-day')];

    function loadLeaflet() {
      return new Promise((resolve, reject) => {
        if (window.L) return resolve(window.L);

        if (!document.querySelector('link[data-leaflet]')) {
          const css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          css.setAttribute('data-leaflet', 'true');
          document.head.appendChild(css);
        }

        const existing = document.querySelector('script[data-leaflet]');
        if (existing) {
          existing.addEventListener('load', () => resolve(window.L), { once: true });
          existing.addEventListener('error', reject, { once: true });
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        script.setAttribute('data-leaflet', 'true');
        script.onload = () => resolve(window.L);
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    async function initMap() {
      const L = await loadLeaflet();
      map = L.map('trip-route-map', { zoomControl: true }).setView([35.6812, 139.7671], 11);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);
      await renderRoute();
    }

    function sleep(ms) {
      return new Promise((resolve) => window.setTimeout(resolve, ms));
    }

    async function geocode(query) {
      const key = 'japon2026:geocode:' + query.toLocaleLowerCase();
      try {
        const cached = localStorage.getItem(key);
        if (cached) return JSON.parse(cached);
      } catch {}

      const url = 'https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=jp&q=' + encodeURIComponent(query);
      const response = await fetch(url, { headers: { 'Accept-Language': 'en,ja;q=0.8' } });
      if (!response.ok) throw new Error('Geocoding failed');
      const data = await response.json();
      if (!data.length) return null;

      const result = { lat: Number(data[0].lat), lon: Number(data[0].lon) };
      try { localStorage.setItem(key, JSON.stringify(result)); } catch {}
      await sleep(1100);
      return result;
    }

    function routeUrl(stops) {
      if (!stops.length) return '#';
      if (stops.length === 1) {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(stops[0].query);
      }
      const first = stops[0].query;
      const last = stops[stops.length - 1].query;
      const middle = stops.slice(1, -1).map((stop) => stop.query).join('|');
      let url = 'https://www.google.com/maps/dir/?api=1&origin=' + encodeURIComponent(first) + '&destination=' + encodeURIComponent(last);
      if (middle) url += '&waypoints=' + encodeURIComponent(middle);
      return url;
    }

    function getVariant(route) {
      const savedKey = 'japon2026:day-plan:' + route.date;
      let saved = currentVariant;
      try { saved = localStorage.getItem(savedKey) ?? currentVariant; } catch {}
      return route.variants.find((variant) => variant.id === saved) ?? route.variants[0];
    }

    function renderVariantButtons(route, activeVariant) {
      if (route.variants.length <= 1) {
        variantEl.classList.add('hidden');
        variantEl.innerHTML = '';
        return;
      }
      variantEl.classList.remove('hidden');
      variantEl.classList.add('flex');
      variantEl.innerHTML = route.variants.map((variant) => {
        const active = variant.id === activeVariant.id;
        return `<button type="button" class="route-variant rounded-xl border px-3 py-2 text-sm font-bold ${active ? 'border-slate-950 bg-slate-950 text-white' : 'border-slate-200 bg-white text-slate-700'}" data-variant="${variant.id}">${variant.label}</button>`;
      }).join('');

      variantEl.querySelectorAll('[data-variant]').forEach((button) => {
        button.addEventListener('click', async () => {
          currentVariant = button.getAttribute('data-variant') ?? 'main';
          try { localStorage.setItem('japon2026:day-plan:' + route.date, currentVariant); } catch {}
          await renderRoute();
        });
      });
    }

    async function renderRoute() {
      if (!map) return;
      const route = routes[currentRoute];
      const variant = getVariant(route);
      currentVariant = variant.id;

      dayButtons.forEach((button, index) => {
        const active = index === currentRoute;
        button.classList.toggle('bg-slate-950', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('bg-white', !active);
        button.classList.toggle('text-slate-700', !active);
      });

      titleEl.textContent = route.title;
      cityEl.textContent = route.date + ' · ' + route.city;
      renderVariantButtons(route, variant);
      googleRouteEl.setAttribute('href', routeUrl(variant.stops));

      stopsEl.innerHTML = variant.stops.map((stop, index) => {
        const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(stop.query);
        const tabelog = stop.tabelog ? `<a href="${stop.tabelog}" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-orange-50 px-2 py-1 text-xs font-bold text-orange-800">Tabelog</a>` : '';
        const streetLink = stop.spotQuery ? `<a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(stop.spotQuery)}" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-amber-100 px-2 py-1 text-xs font-bold text-amber-900">📸 Ir a la calle · a pie</a>` : '';
        const mapcode = stop.mapcode ? `<div class="mt-2 flex flex-wrap items-center gap-2"><span class="rounded-lg bg-white px-2 py-1 text-sm font-black">${stop.mapcode}</span><button type="button" data-copy-route-mapcode="${stop.mapcode}" class="rounded-lg bg-slate-200 px-2 py-1 text-xs font-bold">📋 Copiar MAPCODE</button>${stop.mapcodeKind === 'reference' ? '<span class="text-[11px] font-semibold text-amber-700">⚠️ Referencia, no acceso confirmado</span>' : ''}</div>` : '';
        return `<li class="grid grid-cols-[2rem_1fr] gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-950 text-xs font-black text-white">${index + 1}</span>
          <div>
            <div class="flex items-start justify-between gap-2"><strong class="text-sm text-slate-950">${stop.title}</strong><span class="text-xs text-slate-400">${stop.time || ''}</span></div>
            ${stop.note ? '<p class="mt-1 text-xs text-slate-500">' + stop.note + '</p>' : ''}
            ${mapcode}
            <div class="mt-2 flex flex-wrap gap-2"><a href="${maps}" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-blue-50 px-2 py-1 text-xs font-bold text-blue-800">🅿️ Ir al parking</a>${streetLink}${tabelog}</div>
          </div>
        </li>`;
      }).join('');
      stopsEl.querySelectorAll('[data-copy-route-mapcode]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.getAttribute('data-copy-route-mapcode');
          if (!value) return;
          try { await navigator.clipboard.writeText(value); button.textContent = '✓ Copiado'; }
          catch { button.textContent = 'Copia el código de al lado'; }
        });
      });

      if (routeLayer) {
        routeLayer.remove();
        routeLayer = null;
      }

      statusEl.textContent = 'Calculando posiciones de la ruta…';
      const coords = [];
      for (let i = 0; i < variant.stops.length; i++) {
        const stop = variant.stops[i];
        try {
          const point = await geocode(stop.query);
          if (point) coords.push({ ...point, stop, index: i });
        } catch {}
      }

      if (!coords.length) {
        statusEl.textContent = 'No he podido dibujar la ruta ahora. El botón de Google Maps sigue funcionando.';
        return;
      }

      const L = window.L;
      const group = L.layerGroup();
      coords.forEach((point) => {
        const marker = L.marker([point.lat, point.lon]);
        marker.bindPopup(`<strong>${point.index + 1}. ${point.stop.title}</strong>`);
        marker.addTo(group);
      });

      let routeGeometry = null;
      if (coords.length > 1) {
        const coordinates = coords.map((point) => `${point.lon},${point.lat}`).join(';');
        const router = route.routingMode === 'car' ? 'routed-car' : 'routed-foot';
        const routeEndpoint = `https://routing.openstreetmap.de/${router}/route/v1/driving/${coordinates}?overview=full&geometries=geojson&steps=false`;

        try {
          statusEl.textContent = route.routingMode === 'car'
            ? 'Calculando ruta por carretera…'
            : 'Calculando recorrido por calles y caminos…';
          const response = await fetch(routeEndpoint);
          if (!response.ok) throw new Error('Routing failed');
          const data = await response.json();
          routeGeometry = data?.routes?.[0]?.geometry ?? null;
        } catch {}
      }

      if (routeGeometry) {
        L.geoJSON(routeGeometry, { style: { weight: 5, opacity: 0.85 } }).addTo(group);
      } else if (coords.length > 1) {
        L.polyline(coords.map((point) => [point.lat, point.lon]), { weight: 3, opacity: 0.45, dashArray: '6 8' }).addTo(group);
      }

      group.addTo(map);
      routeLayer = group;
      const bounds = routeGeometry
        ? L.geoJSON(routeGeometry).getBounds()
        : L.latLngBounds(coords.map((point) => [point.lat, point.lon]));
      map.fitBounds(bounds.pad(0.18), { maxZoom: 14 });
      statusEl.textContent = routeGeometry
        ? `Ruta real sobre la red viaria · ${coords.length}/${variant.stops.length} paradas localizadas.`
        : `No se pudo calcular el trazado real; mostrando unión orientativa entre ${coords.length}/${variant.stops.length} paradas. Google Maps sigue disponible para navegar.`;
    }

    dayButtons.forEach((button, index) => {
      button.addEventListener('click', async () => {
        currentRoute = index;
        currentVariant = 'main';
        try { localStorage.setItem('japon2026:selected-date', routes[index].date); } catch {}
        await renderRoute();
        button.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });
    });

    document.querySelector('#locate-me')?.addEventListener('click', () => {
      if (!navigator.geolocation || !map) return;
      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          const L = window.L;
          if (userMarker) userMarker.remove();
          userMarker = L.circleMarker([coords.latitude, coords.longitude], { radius: 8, weight: 3 }).addTo(map).bindPopup('Estoy aquí');
          map.setView([coords.latitude, coords.longitude], 14);
        },
        () => { statusEl.textContent = 'No se pudo acceder a tu ubicación. Revisa el permiso del navegador.'; },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
      );
    });

    const search = document.querySelector('#place-search');
    const placeCards = [...document.querySelectorAll('.our-place')];
    const exportPlaces = document.querySelector('#export-places');
    search?.addEventListener('input', () => {
      const q = search.value.trim().toLocaleLowerCase();
      placeCards.forEach((card) => card.classList.toggle('hidden', q && !(card.getAttribute('data-search') ?? '').includes(q)));
    });

    exportPlaces?.addEventListener('click', () => {
      const escapeCsv = (value) => '"' + String(value ?? '').replaceAll('"', '""') + '"';
      const rows = [
        ['Fecha', 'Ciudad', 'Lugar', 'Búsqueda Maps', 'Google Maps'],
        ...places.map((place) => [
          place.firstDate,
          place.city,
          place.title,
          place.query,
          'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(place.query),
        ]),
      ];
      const csv = '\uFEFF' + rows.map((row) => row.map(escapeCsv).join(',')).join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'Japon2026_lugares.csv';
      link.click();
      URL.revokeObjectURL(url);
    });

    const today = new Date();
    const todayIso = [today.getFullYear(), String(today.getMonth() + 1).padStart(2, '0'), String(today.getDate()).padStart(2, '0')].join('-');
    const requestedDate = new URLSearchParams(window.location.search).get('date');
    let rememberedDate = '';
    try { rememberedDate = localStorage.getItem('japon2026:selected-date') ?? ''; } catch {}
    const preferredDate = requestedDate || rememberedDate;
    const preferredIndex = preferredDate ? routes.findIndex((route) => route.date === preferredDate) : -1;
    const upcoming = routes.findIndex((route) => route.date >= todayIso);
    currentRoute = preferredIndex >= 0 ? preferredIndex : (upcoming >= 0 ? upcoming : Math.max(0, routes.length - 1));

    initMap().catch(() => {
      statusEl.textContent = 'No se pudo cargar el mapa interactivo. Los enlaces de Google Maps siguen disponibles.';
    });
  </script>
</Layout>

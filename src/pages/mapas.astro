---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SHARED_MAP_LISTS } from '../data/trip';
import { isoDate } from '../lib/segments';

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order);
const places = segments.flatMap((segment) =>
  segment.data.days.flatMap((day) =>
    day.activities
      .filter((activity) => activity.locationQuery || activity.address)
      .map((activity) => ({
        title: activity.title,
        city: segment.data.legLabel ?? segment.data.city,
        date: isoDate(day.date),
        category: activity.category,
        status: activity.status,
        query: activity.locationQuery ?? activity.address ?? activity.title,
        tabelog: activity.links?.tabelog ?? (activity.category === 'comida'
          ? `https://tabelog.com/en/rstLst/?vs=1&sk=${encodeURIComponent(activity.title)}`
          : ''),
      })),
  ),
);
---

<Layout title="Mapa · Japón 2026">
  <header class="mb-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Planning + listas compartidas</p>
    <h1 class="text-3xl font-black tracking-tight">Mapa del viaje</h1>
    <p class="mt-2 text-sm leading-relaxed text-slate-500">Selecciona una parada, vela en el mapa y abre ruta desde tu posición. Las comidas tienen Tabelog cuando existe ficha o búsqueda útil.</p>
  </header>

  <div class="sticky top-[65px] z-20 mb-5 grid gap-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:grid-cols-[1fr_auto]">
    <input id="map-search" type="search" placeholder="Sensō-ji, Cattlea, Katsuoji…" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-base outline-none focus:border-slate-400" />
    <button id="locate-me" type="button" class="rounded-xl bg-slate-950 px-4 py-3 text-sm font-bold text-white">◎ Estoy aquí</button>
  </div>

  <div class="mb-5 flex gap-2 overflow-x-auto pb-1">
    <button class="city-filter shrink-0 rounded-full bg-slate-950 px-3 py-2 text-xs font-bold text-white" data-city="">Todo</button>
    {[...new Set(places.map((p) => p.city))].map((city) => <button class="city-filter shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700" data-city={city}>{city}</button>)}
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_1.15fr]">
    <div class="order-2 lg:order-1">
      <section>
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-xl font-black">Paradas del planning</h2>
          <span class="text-xs text-slate-400">{places.length} ubicaciones</span>
        </div>
        <div id="planning-places" class="grid gap-2">
          {places.map((place) => (
            <button type="button" class="place-row rounded-2xl border border-slate-200 bg-white p-3 text-left shadow-sm"
              data-place={place.title} data-city={place.city} data-query={place.query} data-date={place.date} data-tabelog={place.tabelog}>
              <div class="flex items-start justify-between gap-3">
                <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">{place.date} · {place.city}</p><p class="mt-1 font-bold text-slate-950">{place.title}</p></div>
                <span class="text-xs text-slate-400">↗</span>
              </div>
            </button>
          ))}
        </div>
      </section>

      <section class="mt-8">
        <h2 class="text-xl font-black">Listas de Lorena</h2>
        <p class="mt-1 text-sm text-slate-500">Solo se usan como referencia pública. No se hace join, follow ni ningún cambio sobre sus listas.</p>
        <div class="mt-3 grid gap-4">
          {SHARED_MAP_LISTS.map((list) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-4">
              <div class="flex items-start justify-between gap-3">
                <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">{list.city}</p><h3 class="text-lg font-black">{list.title}</h3></div>
                <a href={list.url} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-blue-50 px-3 py-2 text-xs font-bold text-blue-800">Abrir lista ↗</a>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {list.places.map((place) => <button type="button" class="shared-place rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700" data-place={place} data-city={list.city}>{place}</button>)}
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>

    <aside class="order-1 lg:order-2">
      <div class="lg:sticky lg:top-20">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <iframe id="place-map" title="Mapa" class="h-[46vh] min-h-[340px] w-full border-0" loading="lazy" src="https://www.google.com/maps?q=Tokyo%2CJapan&output=embed"></iframe>
          <div class="p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Seleccionado</p>
            <h2 id="map-place-title" class="mt-1 text-lg font-black">Tokio</h2>
            <p id="map-place-meta" class="mt-1 text-xs text-slate-500">Pulsa una parada para verla aquí.</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a id="map-place-link" href="https://www.google.com/maps/search/?api=1&query=Tokyo%20Japan" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-slate-950 px-4 py-3 text-sm font-bold text-white">Google Maps ↗</a>
              <a id="map-directions-link" href="https://www.google.com/maps/dir/?api=1&destination=Tokyo%20Japan" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-800">🧭 Cómo llegar</a>
              <a id="map-apple-link" href="https://maps.apple.com/?q=Tokyo%20Japan" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-slate-100 px-4 py-3 text-sm font-bold text-slate-800"> Maps</a>
              <a id="map-tabelog-link" href="#" target="_blank" rel="noopener noreferrer" class="hidden rounded-xl bg-orange-50 px-4 py-3 text-sm font-bold text-orange-800">🍽️ Tabelog</a>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <script>
    const search = document.querySelector('#map-search');
    const rows = [...document.querySelectorAll('.place-row')];
    const shared = [...document.querySelectorAll('.shared-place')];
    const filters = [...document.querySelectorAll('.city-filter')];
    const frame = document.querySelector('#place-map');
    const title = document.querySelector('#map-place-title');
    const meta = document.querySelector('#map-place-meta');
    const maps = document.querySelector('#map-place-link');
    const directions = document.querySelector('#map-directions-link');
    const apple = document.querySelector('#map-apple-link');
    const tabelog = document.querySelector('#map-tabelog-link');
    let cityFilter = '';

    function selectPlace(name, query, city = '', date = '', tabelogUrl = '') {
      const q = query || name;
      if (frame) frame.setAttribute('src', `https://www.google.com/maps?q=${encodeURIComponent(q)}&output=embed`);
      if (title) title.textContent = name;
      if (meta) meta.textContent = [date, city].filter(Boolean).join(' · ') || 'Ubicación seleccionada';
      if (maps) maps.setAttribute('href', `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`);
      if (directions) directions.setAttribute('href', `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(q)}`);
      if (apple) apple.setAttribute('href', `https://maps.apple.com/?q=${encodeURIComponent(q)}`);
      if (tabelog) {
        if (tabelogUrl) {
          tabelog.setAttribute('href', tabelogUrl);
          tabelog.classList.remove('hidden');
        } else {
          tabelog.classList.add('hidden');
        }
      }
    }

    rows.forEach((row) => row.addEventListener('click', () => {
      selectPlace(
        row.getAttribute('data-place') ?? '',
        row.getAttribute('data-query') ?? '',
        row.getAttribute('data-city') ?? '',
        row.getAttribute('data-date') ?? '',
        row.getAttribute('data-tabelog') ?? '',
      );
      rows.forEach((item) => item.classList.remove('ring-2', 'ring-slate-950'));
      row.classList.add('ring-2', 'ring-slate-950');
    }));

    shared.forEach((chip) => chip.addEventListener('click', () => {
      const name = chip.getAttribute('data-place') ?? '';
      const city = chip.getAttribute('data-city') ?? '';
      selectPlace(name, name + ' ' + city, city);
    }));

    function applyFilters() {
      const q = (search?.value ?? '').trim().toLocaleLowerCase();
      rows.forEach((row) => {
        const text = (row.textContent ?? '').toLocaleLowerCase();
        const matchText = !q || text.includes(q);
        const matchCity = !cityFilter || row.getAttribute('data-city') === cityFilter;
        row.classList.toggle('hidden', !(matchText && matchCity));
      });
    }

    search?.addEventListener('input', applyFilters);
    filters.forEach((button) => button.addEventListener('click', () => {
      cityFilter = button.getAttribute('data-city') ?? '';
      filters.forEach((item) => {
        item.classList.remove('bg-slate-950', 'text-white');
        item.classList.add('bg-white', 'text-slate-700');
      });
      button.classList.remove('bg-white', 'text-slate-700');
      button.classList.add('bg-slate-950', 'text-white');
      applyFilters();
    }));

    document.querySelector('#locate-me')?.addEventListener('click', () => {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          const q = `${coords.latitude},${coords.longitude}`;
          selectPlace('Estoy aquí', q, 'Posición del dispositivo');
        },
        () => {
          if (meta) meta.textContent = 'No se pudo acceder a la ubicación. Revisa el permiso del navegador.';
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
      );
    });
  </script>
</Layout>

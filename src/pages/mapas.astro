---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { isoDate } from '../lib/segments';
import { createMapDays } from '../lib/map-planner.mjs';

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order);

const routes = createMapDays(segments.map((segment) => segment.data));

const placeMap = new Map<string, { title: string; query: string; city: string; firstDate: string; category: string; tabelog: string }>();

function addPlace(place: { title: string; query: string; city: string; firstDate: string; category: string; tabelog?: string }) {
  const key = place.query.toLocaleLowerCase();
  if (!placeMap.has(key)) {
    placeMap.set(key, { ...place, tabelog: place.tabelog ?? '' });
  }
}

for (const segment of segments) {
  const city = segment.data.legLabel ?? segment.data.city;

  for (const day of segment.data.days) {
    const firstDate = isoDate(day.date);

    for (const activity of day.activities) {
      const query = activity.locationQuery ?? activity.address;
      if (!query) continue;
      addPlace({
        title: activity.title,
        query,
        city,
        firstDate,
        category: activity.category,
        tabelog: activity.links?.tabelog,
      });
    }

    for (const stop of day.routeStops ?? []) {
      addPlace({
        title: stop.title,
        query: stop.locationQuery,
        city,
        firstDate,
        category: 'otro',
      });
    }
  }

  for (const candidate of segment.data.candidateModules) {
    if (!candidate.forDate) continue;
    const firstDate = isoDate(candidate.forDate);
    for (const activity of candidate.activities) {
      const query = activity.locationQuery ?? activity.address;
      if (!query) continue;
      addPlace({
        title: activity.title,
        query,
        city,
        firstDate,
        category: activity.category,
        tabelog: activity.links?.tabelog,
      });
    }
  }
}

const places = [...placeMap.values()].sort((a, b) => a.firstDate.localeCompare(b.firstDate) || a.title.localeCompare(b.title, 'es'));
---

<Layout title="Ruta · Japón 2026">
  <header class="mb-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Nuestra lista canónica</p>
    <h1 class="text-3xl font-black tracking-tight">Ruta Japón 2026</h1>
    <p class="mt-2 text-sm leading-relaxed text-slate-500">
      Solo aparecen lugares de nuestro planning. Las listas de terceros ya no alimentan el mapa principal.
    </p>
  </header>

  <a href={import.meta.env.BASE_URL + "fotos-tokyo-tower/"} class="mb-5 flex items-center justify-between gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 shadow-sm">
    <div><p class="text-xs font-black uppercase tracking-wide text-red-700">📸 TikTok · Tokyo Tower</p><p class="mt-1 font-black text-slate-950">Los 8 spots de fotos, con mapa y coordenadas</p><p class="mt-1 text-xs text-slate-600">Incluye las famosas escaleras y enlaces para llegar andando.</p></div>
    <span class="shrink-0 text-xl text-red-700">→</span>
  </a>


  <section class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex gap-2 overflow-x-auto pb-2" id="route-days" aria-label="Seleccionar día del viaje">
      {routes.map((route, index) => (
        <button
          type="button"
          class="route-day shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700"
          data-route-index={index}
        >
          {new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(route.date + 'T00:00:00Z'))}
        </button>
      ))}
    </div>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-2">
      <div class="min-w-0">
        <p id="route-city" class="text-xs font-bold uppercase tracking-wide text-slate-500"></p>
        <h2 id="route-title" class="mt-1 break-words text-lg font-black leading-snug"></h2>
      </div>
      <button id="locate-me" type="button" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-bold">◎ Estoy aquí</button>
    </div>

    <div id="route-variants" class="mt-3 hidden flex-wrap gap-2" aria-label="Elegir ruta alternativa"></div>

    <div class="mt-4 grid grid-cols-2 gap-2 rounded-2xl bg-slate-100 p-1" id="map-mode-buttons">
      <button type="button" data-map-mode="complete" class="rounded-xl px-3 py-3 text-sm font-black" aria-pressed="true">🗺️ Día completo</button>
      <button type="button" data-map-mode="parts" class="rounded-xl px-3 py-3 text-sm font-black" aria-pressed="false">🧩 Por tramos</button>
    </div>
    <div id="route-parts" class="mt-3 hidden flex-wrap gap-2" aria-label="Seleccionar tramo del día"></div>
    <p id="route-summary" class="mt-3 text-xs leading-relaxed text-slate-600"></p>

    <div id="route-options" class="mt-3"></div>

    <div id="route-map-status" role="status" aria-live="polite" class="mt-3 rounded-xl bg-slate-100 px-3 py-2 text-xs text-slate-600">
      Preparando mapa…
    </div>
    <div id="trip-route-map" class="mt-3 h-[45vh] min-h-[330px] overflow-hidden rounded-2xl bg-slate-100"></div>

    <p class="mt-3 text-xs leading-relaxed text-slate-500">
      Los puntos del día están ordenados. El recorrido a pie o en coche solo se dibuja en tramos de ese tipo;
      para metro, tren y desplazamientos largos tienes el enlace entre paradas. No se inventan líneas rectas.
    </p>
    <div id="route-stage-list" class="mt-4 grid gap-3"></div>
  </section>

  <section class="mt-8">
    <div class="mb-3 flex items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Guardado en nuestro planning</p>
        <h2 class="text-2xl font-black">Lugares Japón 2026</h2>
      </div>
      <span class="text-xs text-slate-400">{places.length} lugares</span>
    </div>

    <div class="sticky top-14 z-20 mb-4 rounded-2xl border border-slate-200 bg-slate-50/95 p-3 backdrop-blur">
      <input id="place-search" type="search" placeholder="Buscar Cattlea, Sensō-ji, Katsuo-ji…" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-3 text-base outline-none focus:border-slate-400" />
      <button id="export-places" type="button" class="mt-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700">⬇️ Exportar lugares CSV</button>
    </div>

    <div id="our-places" class="grid gap-2 sm:grid-cols-2">
      {places.map((place) => {
        const google = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.query)}`;
        const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(place.query)}`;
        return (
          <article class="our-place rounded-2xl border border-slate-200 bg-white p-3 shadow-sm" data-search={`${place.title} ${place.city} ${place.query}`.toLocaleLowerCase()}>
            <p class="text-[11px] font-bold uppercase tracking-wide text-slate-400">{place.firstDate} · {place.city}</p>
            <h3 class="mt-1 font-black text-slate-950">{place.title}</h3>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href={google} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-blue-50 px-2.5 py-2 text-xs font-bold text-blue-800">📍 Maps</a>
              <a href={directions} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-emerald-50 px-2.5 py-2 text-xs font-bold text-emerald-800">🧭 Ir</a>
              {place.tabelog && <a href={place.tabelog} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-orange-50 px-2.5 py-2 text-xs font-bold text-orange-800">🍽️ Tabelog</a>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <script is:inline define:vars={{ routes, places }}>
    // La pestaña Mapa usa los días del itinerario y sus tramos, sin crear trayectos ficticios.
    let map, routeLayer, userMarker;
    let currentRoute = 0, currentVariant = 'main', viewMode = 'complete', selectedPart = 0;
    let sequence = 0, showOptional = false;
    const expanded = new Set(), selectedExtras = new Map(), geocodeCache = new Map();
    let geocodeQueue = Promise.resolve(), lastRequest = 0;
    const $ = (selector) => document.querySelector(selector);
    const statusEl = $('#route-map-status'), titleEl = $('#route-title');
    const cityEl = $('#route-city'), summaryEl = $('#route-summary');
    const stagesEl = $('#route-stage-list'), variantsEl = $('#route-variants');
    const partsEl = $('#route-parts'), optionsEl = $('#route-options');
    const dayButtons = Array.from(document.querySelectorAll('.route-day'));
    const modeButtons = Array.from(document.querySelectorAll('[data-map-mode]'));
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, ch =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    const maps = (query) => 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(query);
    const directions = (a, b, mode) => 'https://www.google.com/maps/dir/?api=1&origin=' +
      encodeURIComponent(a) + '&destination=' + encodeURIComponent(b) +
      '&travelmode=' + (mode === 'walk' ? 'walking' : mode === 'drive' ? 'driving' : 'transit');
    const read = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
    const save = (key, value) => { try { localStorage.setItem(key, value); } catch {} };
    const current = () => routes[currentRoute];
    const extras = () => {
      if (!selectedExtras.has(current().date)) selectedExtras.set(current().date, new Set());
      return selectedExtras.get(current().date);
    };

    function currentStages(route) {
      const alternate = route.variants.find(v => v.id === currentVariant);
      const result = (alternate?.stages ?? route.stages).map(s => ({ ...s, stops: [...s.stops] }));
      if (!alternate && extras().size && result.length) {
        const last = result[result.length - 1];
        const lastIsHotel = last.stops.at(-1)?.kind === 'hotel';
        const hotel = lastIsHotel ? last.stops.pop() : null;
        last.stops.push(...route.optional.filter(s => extras().has(s.id)));
        if (hotel) last.stops.push(hotel);
        last.mode = 'mixed'; // Añadidos manualmente: no sabemos qué transporte elegir.
      }
      return result;
    }
    const shown = (stage) => stage.expandable && !expanded.has(current().date + ':' + stage.id)
      && stage.stops.length > 2 ? [stage.stops[0], stage.stops.at(-1)] : stage.stops;

    function drawControls(route, stages) {
      dayButtons.forEach((button, i) => {
        const active = i === currentRoute;
        button.classList.toggle('bg-slate-950', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('bg-white', !active);
        button.classList.toggle('text-slate-700', !active);
        button.setAttribute('aria-pressed', String(active));
      });
      cityEl.textContent = route.date + ' · ' + route.city;
      titleEl.textContent = route.title;
      variantsEl.innerHTML = '';
      if (route.variants.length) {
        variantsEl.classList.remove('hidden');
        variantsEl.classList.add('flex');
        [{ id: 'main', label: route.mainLabel }, ...route.variants].forEach(item => {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = item.label;
          button.setAttribute('aria-pressed', String(item.id === currentVariant));
          button.className = 'rounded-xl border px-3 py-2 text-xs font-bold ' +
            (item.id === currentVariant ? 'border-slate-950 bg-slate-950 text-white' :
              'border-slate-200 bg-white text-slate-700');
          button.addEventListener('click', () => {
            currentVariant = item.id;
            selectedPart = 0;
            save('japon2026:day-plan:' + route.date, currentVariant);
            render();
          });
          variantsEl.appendChild(button);
        });
      } else variantsEl.classList.add('hidden');
      modeButtons.forEach(button => {
        const on = button.dataset.mapMode === viewMode;
        button.className = 'rounded-xl px-3 py-3 text-sm font-black ' +
          (on ? 'bg-slate-950 text-white shadow-sm' : 'bg-transparent text-slate-600');
        button.setAttribute('aria-pressed', String(on));
      });
      partsEl.innerHTML = '';
      partsEl.classList.toggle('hidden', viewMode !== 'parts');
      if (viewMode === 'parts') {
        partsEl.classList.add('flex');
        stages.forEach((stage, i) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = stage.label;
          button.className = 'rounded-xl border px-3 py-2 text-xs font-bold ' +
            (selectedPart === i ? 'border-blue-700 bg-blue-50 text-blue-900' :
              'border-slate-200 bg-white text-slate-700');
          button.setAttribute('aria-pressed', String(selectedPart === i));
          button.addEventListener('click', () => { selectedPart = i; render(); });
          partsEl.appendChild(button);
        });
      }
      summaryEl.textContent = route.hotelStart && route.hotelEnd
        ? 'De ' + route.hotelStart + ' a ' + route.hotelEnd +
          '. Las paradas opcionales no entran salvo que las añadas.'
        : 'Ruta del día con las paradas del planning. Opcionales aparte.';
    }

    function drawOptional(route) {
      optionsEl.innerHTML = '';
      if (!route.optional.length || currentVariant !== 'main') return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold';
      button.textContent = (showOptional ? '▴ Ocultar' : '▾ Mostrar') +
        ' opcionales (' + extras().size + '/' + route.optional.length + ')';
      button.addEventListener('click', () => { showOptional = !showOptional; render(); });
      optionsEl.appendChild(button);
      if (!showOptional) return;
      const list = document.createElement('div');
      list.className = 'mt-2 grid gap-2';
      route.optional.forEach(stop => {
        const row = document.createElement('div');
        row.className = 'flex min-w-0 items-center justify-between gap-2 rounded-xl bg-slate-50 p-2';
        const title = document.createElement('span');
        title.className = 'min-w-0 break-words text-xs font-semibold text-slate-700';
        title.textContent = stop.title;
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'shrink-0 rounded-lg bg-slate-950 px-3 py-2 text-xs font-bold text-white';
        toggle.textContent = extras().has(stop.id) ? '✓ Quitar' : '+ Añadir';
        toggle.addEventListener('click', () => {
          const chosen = extras();
          if (chosen.has(stop.id)) chosen.delete(stop.id); else chosen.add(stop.id);
          render();
        });
        row.append(title, toggle);
        list.appendChild(row);
      });
      optionsEl.appendChild(list);
      const note = document.createElement('p');
      note.className = 'mt-2 text-xs text-amber-700';
      note.textContent = 'Se añade antes de volver al hotel. Revisa el orden y el transporte si decides ir.';
      optionsEl.appendChild(note);
    }

    function card(stage, index) {
      const visible = shown(stage);
      const modeLabel = { walk: 'A pie', drive: 'Coche', transit: 'Transporte público',
        mixed: 'Varios transportes' }[stage.mode] ?? 'Transporte por elegir';
      const isOpen = expanded.has(current().date + ':' + stage.id);
      let html = '<article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-3">' +
        '<p class="text-xs font-bold text-slate-500">Tramo ' + (index + 1) + ' · ' + esc(modeLabel) + '</p>' +
        '<h3 class="mt-1 break-words text-base font-black">' + esc(stage.label) + '</h3>';
      if (stage.expandable && stage.stops.length > 2)
        html += '<button type="button" data-expand="' + esc(stage.id) +
          '" class="mt-2 rounded-lg bg-amber-100 px-3 py-2 text-xs font-bold text-amber-900">' +
          (isOpen ? '− Resumir recorrido' : '+ Ver las ' + stage.stops.length + ' paradas') + '</button>' +
          (!isOpen ? '<p class="mt-2 text-xs text-amber-700">Resumen: solo inicio y final. Abre el detalle para dibujar todo el recorrido.</p>' : '');
      html += '<ol class="mt-3 grid gap-2">';
      visible.forEach((stop, i) => {
        const prev = visible[i - 1], dir = prev ? directions(prev.query, stop.query, stage.mode) : '';
        html += '<li class="min-w-0 rounded-xl border border-slate-200 bg-white p-3">' +
          '<p class="break-words text-sm font-bold">' + (i + 1) + '. ' + esc(stop.title) + '</p>';
        if (stop.time || stop.note) html += '<p class="mt-1 break-words text-xs leading-relaxed text-slate-500">' +
          esc([stop.time, stop.note].filter(Boolean).join(' · ')) + '</p>';
        if (stop.mapcode) html += '<div class="mt-2 flex flex-wrap items-center gap-2">' +
          '<span class="text-sm font-black">' + esc(stop.mapcode) + '</span>' +
          '<button data-mapcode="' + esc(stop.mapcode) +
          '" type="button" class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-bold">Copiar MAPCODE</button>' +
          (stop.mapcodeKind === 'reference' ? '<span class="text-[11px] text-amber-700">Referencia aproximada</span>' : '') + '</div>';
        html += '<div class="mt-2 flex flex-wrap gap-2">' +
          '<a href="' + esc(maps(stop.query)) + '" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-blue-50 px-3 py-2 text-xs font-bold text-blue-800">📍 Ver</a>' +
          (dir ? '<a href="' + esc(dir) + '" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-900">🧭 Desde anterior</a>' : '') +
          (stop.spotQuery ? '<a href="' + esc(maps(stop.spotQuery)) + '" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-amber-50 px-3 py-2 text-xs font-bold">📸 Punto de foto</a>' : '') +
          '</div></li>';
      });
      return html + '</ol></article>';
    }

    function addHandlers() {
      stagesEl.querySelectorAll('[data-expand]').forEach(button => button.addEventListener('click', () => {
        const key = current().date + ':' + button.getAttribute('data-expand');
        if (expanded.has(key)) expanded.delete(key); else expanded.add(key);
        render();
      }));
      stagesEl.querySelectorAll('[data-mapcode]').forEach(button => button.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(button.getAttribute('data-mapcode')); button.textContent = '✓ Copiado'; }
        catch { button.textContent = 'Copia el código de al lado'; }
      }));
    }

    function directCoords(text) {
      const m = String(text).trim().match(/^(-?\d{1,2}\.\d+)\s*,\s*(-?\d{1,3}\.\d+)$/);
      if (!m) return null;
      const lat = Number(m[1]), lon = Number(m[2]);
      return lat >= 20 && lat <= 50 && lon >= 120 && lon <= 155 ? { lat, lon } : null;
    }
    async function geocode(query) {
      const exact = directCoords(query);
      if (exact) return exact;
      const key = query.toLowerCase();
      if (geocodeCache.has(key)) return geocodeCache.get(key);
      const previous = read('japon2026:geocode:' + key);
      if (previous) {
        try {
          const cached = JSON.parse(previous);
          if (Number.isFinite(cached.lat) && Number.isFinite(cached.lon)) {
            geocodeCache.set(key, cached); return cached;
          }
        } catch {}
      }
      // Nominatim: secuenciar peticiones y respetar 1 solicitud por segundo.
      const pending = geocodeQueue.then(async () => {
        const pause = Math.max(0, 1200 - (Date.now() - lastRequest));
        if (pause) await new Promise(r => setTimeout(r, pause));
        lastRequest = Date.now();
        try {
          const endpoint = 'https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=jp&q=' + encodeURIComponent(query);
          const response = await fetch(endpoint, { headers: { 'Accept-Language': 'ja,en;q=0.8' } });
          if (!response.ok) return null;
          const result = await response.json();
          if (!result[0]) return null;
          const coords = { lat: Number(result[0].lat), lon: Number(result[0].lon) };
          if (!Number.isFinite(coords.lat) || !Number.isFinite(coords.lon)) return null;
          geocodeCache.set(key, coords);
          save('japon2026:geocode:' + key, JSON.stringify(coords));
          return coords;
        } catch { return null; }
      });
      geocodeQueue = pending.then(() => {}, () => {});
      return pending;
    }

    async function drawMap(stages, token) {
      if (!map) {
        statusEl.textContent = 'Mapa no disponible. Los botones de Google Maps sí funcionan.';
        return;
      }
      if (routeLayer) { routeLayer.remove(); routeLayer = null; }
      const leaflet = window.L, layer = leaflet.layerGroup();
      const geo = new Map(), unique = [];
      for (const stage of stages) for (const point of shown(stage))
        if (point.query && !unique.some(x => x.query === point.query)) unique.push(point);
      if (!unique.length) { statusEl.textContent = 'No hay ubicaciones en este tramo.'; return; }
      statusEl.textContent = 'Buscando lugares (0/' + unique.length + ')…';
      for (let i = 0; i < unique.length; i++) {
        const stop = unique[i];
        const coords = await geocode(stop.query);
        if (token !== sequence) return;
        if (coords) {
          geo.set(stop.query, coords);
          const pin = leaflet.divIcon({
            className: '',
            html: '<span style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border:2px solid white;border-radius:100%;background:#0f172a;color:white;font-weight:bold;font-size:12px;box-shadow:0 1px 5px #64748b">' + (i + 1) + '</span>',
            iconSize: [28, 28], iconAnchor: [14, 14]
          });
          leaflet.marker([coords.lat, coords.lon], { icon: pin }).bindPopup('<strong>' +
            esc(stop.title) + '</strong><p>' + esc(stop.note || '') + '</p>').addTo(layer);
        }
        statusEl.textContent = 'Buscando lugares (' + (i + 1) + '/' + unique.length + ')…';
      }
      let traced = 0;
      for (const stage of stages) {
        // Con la subruta cerrada solo mostramos sus extremos, sin trazar un atajo falso.
        if (!['walk', 'drive'].includes(stage.mode) ||
            (stage.expandable && shown(stage).length < stage.stops.length)) continue;
        const route = shown(stage);
        if (route.length < 2 || route.length > 18 || route.some(x => !geo.has(x.query))) continue;
        const points = route.map(stop => {
          const g = geo.get(stop.query); return g.lon + ',' + g.lat;
        }).join(';');
        const profile = stage.mode === 'walk' ? 'routed-foot' : 'routed-car';
        const url = 'https://routing.openstreetmap.de/' + profile +
          '/route/v1/driving/' + points + '?overview=full&geometries=geojson&steps=false';
        try {
          const res = await fetch(url);
          if (token !== sequence) return;
          if (!res.ok) continue;
          const data = await res.json();
          if (data?.routes?.[0]?.geometry) {
            leaflet.geoJSON(data.routes[0].geometry, { style: { weight: 4, opacity: .85 } }).addTo(layer);
            traced++;
          }
        } catch {}
      }
      if (token !== sequence) return;
      layer.addTo(map); routeLayer = layer;
      if (geo.size) {
        const bounds = leaflet.latLngBounds([...geo.values()].map(c => [c.lat, c.lon]));
        map.fitBounds(bounds.pad(.17), { maxZoom: 14 });
      }
      statusEl.textContent = geo.size + '/' + unique.length + ' lugares localizados. ' +
        (traced ? traced + ' tramo(s) trazados por calles. ' : '') +
        'El tren y metro se abren entre paradas; no dibujamos líneas ficticias.';
    }

    function render() {
      const route = current();
      if (!route) return;
      if (!route.variants.some(v => v.id === currentVariant)) currentVariant = 'main';
      const stages = currentStages(route);
      if (!stages.length) return;
      selectedPart = Math.max(0, Math.min(selectedPart, stages.length - 1));
      const visible = viewMode === 'complete' ? stages : [stages[selectedPart]];
      drawControls(route, stages);
      drawOptional(route);
      stagesEl.innerHTML = visible.map(s => card(s, stages.indexOf(s))).join('');
      addHandlers();
      const token = ++sequence;
      drawMap(visible, token).catch(() => {
        if (token === sequence) statusEl.textContent = 'Error del mapa. Los enlaces de cada parada siguen disponibles.';
      });
    }

    modeButtons.forEach(button => button.addEventListener('click', () => {
      viewMode = button.dataset.mapMode;
      save('japon2026:map:view', viewMode);
      render();
    }));
    dayButtons.forEach((button, i) => button.addEventListener('click', () => {
      currentRoute = i;
      currentVariant = read('japon2026:day-plan:' + current().date) || 'main';
      selectedPart = 0;
      save('japon2026:selected-date', current().date);
      render();
      button.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }));
    $('#locate-me')?.addEventListener('click', () => {
      if (!navigator.geolocation || !map) return;
      navigator.geolocation.getCurrentPosition(({ coords }) => {
        if (userMarker) userMarker.remove();
        userMarker = window.L.circleMarker([coords.latitude, coords.longitude], { radius: 8, weight: 3 })
          .addTo(map).bindPopup('Estoy aquí');
        map.setView([coords.latitude, coords.longitude], 14);
      }, () => { statusEl.textContent = 'No se pudo acceder a tu ubicación.'; },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 });
    });
    const search = $('#place-search');
    const cards = Array.from(document.querySelectorAll('.our-place'));
    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      cards.forEach(c => c.classList.toggle('hidden',
        Boolean(q && !(c.getAttribute('data-search') || '').includes(q))));
    });
    $('#export-places')?.addEventListener('click', () => {
      const quote = v => '"' + String(v ?? '').replaceAll('"', '""') + '"';
      const rows = [['Fecha', 'Ciudad', 'Lugar', 'Búsqueda Maps', 'Google Maps'],
        ...places.map(p => [p.firstDate, p.city, p.title, p.query, maps(p.query)])];
      const csv = '\uFEFF' + rows.map(row => row.map(quote).join(',')).join('\n');
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url; link.download = 'Japon2026_lugares.csv'; link.click(); URL.revokeObjectURL(url);
    });
    const queryDate = new URLSearchParams(window.location.search).get('date');
    const today = new Intl.DateTimeFormat('en-CA', {
      year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Tokyo'
    }).format(new Date());
    const preferred = queryDate || read('japon2026:selected-date');
    const index = routes.findIndex(r => r.date === preferred);
    const future = routes.findIndex(r => r.date >= today);
    currentRoute = index >= 0 ? index : (future >= 0 ? future : Math.max(0, routes.length - 1));
    currentVariant = read('japon2026:day-plan:' + current().date) || 'main';
    viewMode = read('japon2026:map:view') === 'parts' ? 'parts' : 'complete';
    loadMap();

    function loadMap() {
      if (window.L) return initMap(window.L);
      if (!document.querySelector('link[data-leaflet]')) {
        const css = document.createElement('link');
        css.rel = 'stylesheet'; css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        css.dataset.leaflet = 'yes'; document.head.appendChild(css);
      }
      const js = document.createElement('script');
      js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      js.onload = () => initMap(window.L);
      js.onerror = () => render();
      document.head.appendChild(js);
    }
    function initMap(L) {
      map = L.map('trip-route-map').setView([35.6812, 139.7671], 11);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);
      render();
    }
  </script>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import DayBlock from '../../components/DayBlock.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate, getDayAlternatives, getModulesWithContent } from '../../lib/segments';
import { SHARED_MAP_LISTS } from '../../data/trip';

export async function getStaticPaths() {
  const segments = await getCollection('segments');
  return segments.map((segment) => ({ params: { slug: segment.id }, props: { segment } }));
}

interface Props { segment: CollectionEntry<'segments'>; }
const { segment } = Astro.props;
const { data } = segment;
const modulesWithContent = getModulesWithContent(data);
const title = data.legLabel ?? data.city;
const relevantLists = SHARED_MAP_LISTS.filter((list) => {
  const c = data.city.toLowerCase();
  return list.city.toLowerCase().includes(c) || (c === 'tokio' && list.id === 'fuji');
});
---

<Layout title={`${title} · Japón 2026`}>
  <header class="mb-7">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Tramo {data.order}</p>
    <h1 class="text-3xl font-black tracking-tight">{title}</h1>
    <p class="mt-1 text-sm text-slate-500">{formatDate(data.startDate)} – {formatDate(data.endDate)}</p>

    {data.hotel && (
      <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Hotel</p>
        <p class="mt-1 font-black">🏨 {data.hotel.name}</p>
        {data.hotel.mapsUrl && <a href={data.hotel.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex rounded-xl bg-blue-50 px-3 py-2 text-sm font-bold text-blue-800">📍 Abrir en Maps</a>}
      </div>
    )}

    {relevantLists.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {relevantLists.map((list) => <a href={list.url} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700">🗺️ {list.title} ↗</a>)}
      </div>
    )}
  </header>

  <div class="grid gap-10">
    {data.days.map((day) => <DayBlock day={day} city={title} alternatives={getDayAlternatives(data, day.date)} />)}
    {modulesWithContent.length > 0 && (
      <section>
        <h2 class="mb-3 text-xl font-black">Módulos candidatos</h2>
        {modulesWithContent.map((module) => (
          <div class="mb-6">
            <h3 class="mb-3 font-bold">{module.title}</h3>
            <ul class="grid gap-3">{module.activities.map((activity) => <ActivityCard activity={activity} />)}</ul>
          </div>
        ))}
      </section>
    )}
  </div>
</Layout>

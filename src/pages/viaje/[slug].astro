---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate, formatDayHeading, getModulesWithContent, hasContent } from '../../lib/segments';

export async function getStaticPaths() {
  const segments = await getCollection('segments');
  return segments.map((segment) => ({
    params: { slug: segment.id },
    props: { segment },
  }));
}

interface Props {
  segment: CollectionEntry<'segments'>;
}

const { segment } = Astro.props;
const { data } = segment;
const modulesWithContent = getModulesWithContent(data);
const title = data.legLabel ?? data.city;
---

<Layout title={`${title} — Japón 2026`}>
  <header class="mb-6">
    <p class="text-sm font-medium text-slate-500">Tramo {data.order}</p>
    <h1 class="text-2xl font-bold tracking-tight">{title}</h1>
    <p class="mt-1 text-slate-600">{formatDate(data.startDate)} – {formatDate(data.endDate)}</p>

    <div class="mt-3 rounded-xl border border-slate-200 bg-white p-3 text-sm">
      <p class="font-medium text-slate-900">🏨 {data.hotel.name}</p>
      {(data.hotel.checkIn || data.hotel.checkOut) && (
        <p class="mt-1 text-slate-500">
          {data.hotel.checkIn && <>Check-in: {data.hotel.checkIn}</>}
          {data.hotel.checkIn && data.hotel.checkOut && ' · '}
          {data.hotel.checkOut && <>Check-out: {data.hotel.checkOut}</>}
        </p>
      )}
      {data.hotel.mapsUrl && (
        <a
          href={data.hotel.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1 rounded-full bg-sky-50 px-3 py-1.5 text-sm font-medium text-sky-700 hover:bg-sky-100"
        >
          📍 Abrir en Google Maps
        </a>
      )}
    </div>
  </header>

  {
    hasContent(data) ? (
      <div class="flex flex-col gap-8">
        {data.days.length > 0 && (
          <section class="flex flex-col gap-6">
            {data.days.map((day) => (
              <div>
                <p class="text-xs font-medium tracking-wide text-slate-400 uppercase">{formatDayHeading(day.date)}</p>
                <h2 class="mb-3 text-lg font-semibold text-slate-900">
                  {day.title ?? formatDayHeading(day.date)}
                </h2>
                <ul class="flex flex-col gap-3">
                  {day.activities.map((activity) => (
                    <ActivityCard activity={activity} />
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )}

        {modulesWithContent.length > 0 && (
          <section class="flex flex-col gap-6">
            <h2 class="text-lg font-semibold text-slate-900">Módulos candidatos</h2>
            {modulesWithContent.map((candidateModule) => (
              <div>
                <h3 class="mb-3 text-base font-medium text-slate-800">{candidateModule.title}</h3>
                <ul class="flex flex-col gap-3">
                  {candidateModule.activities.map((activity) => (
                    <ActivityCard activity={activity} />
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )}
      </div>
    ) : (
      <EmptyState />
    )
  }
</Layout>

---
import Layout from '../layouts/Layout.astro';
import DayBlock from '../components/DayBlock.astro';
import { getCollection } from 'astro:content';
import { flattenDays, formatDayHeading, isoDate } from '../lib/segments';

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order);
const days = flattenDays(segments);
---

<Layout title="Hoy · Japón 2026">
  <header class="mb-4">
    <div class="flex items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-black tracking-tight">Hoy</h1>
        <p id="today-context" class="mt-1 text-sm text-slate-500">Buscando el día del viaje…</p>
      </div>
      <button id="jump-today" type="button" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700">Ir a hoy</button>
    </div>
  </header>

  <section class="mb-5 overflow-hidden rounded-2xl bg-slate-950 text-white shadow-sm">
    <button id="next-card" type="button" class="w-full p-4 text-left">
      <span id="next-kicker" class="block text-xs font-bold uppercase tracking-[0.16em] text-red-300">Siguiente</span>
      <span id="next-title" class="mt-1 block text-lg font-black">Calculando…</span>
      <span id="next-note" class="mt-1 block text-xs text-slate-400"></span>
      <span class="mt-2 block text-xs font-bold text-slate-300">Toca para abrir esa parada ↓</span>
    </button>
    <div class="border-t border-white/10 px-4 py-3">
      <button id="locate-next" type="button" class="rounded-xl bg-white/10 px-3 py-2 text-xs font-bold text-white">📍 Desde donde estoy</button>
      <p id="next-distance" class="mt-2 hidden text-xs leading-relaxed text-slate-300"></p>
    </div>
  </section>

  <div class="sticky top-14 z-30 -mx-4 mb-5 grid grid-cols-[auto_1fr_auto] items-center gap-2 border-y border-slate-200 bg-slate-50/95 px-4 py-3 backdrop-blur">
    <button id="prev-day" type="button" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold">←</button>
    <p id="selected-day-label" class="text-center text-sm font-black text-slate-900"></p>
    <button id="next-day" type="button" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold">→</button>
  </div>

  <div id="today-days">
    {days.map((entry, index) => (
      <div
        class="today-entry hidden"
        data-day-index={index}
        data-date={isoDate(entry.day.date)}
        data-city={entry.segmentTitle}
        data-label={`${formatDayHeading(entry.day.date)} · ${entry.segmentTitle}`}
      >
        <DayBlock day={entry.day} city={entry.segmentTitle} alternatives={entry.alternatives} />
      </div>
    ))}
  </div>

  <noscript><p class="rounded-2xl bg-amber-50 p-4 text-sm">Activa JavaScript para que el modo Hoy seleccione automáticamente la fecha.</p></noscript>

  <script>
    const entries = [...document.querySelectorAll('.today-entry')];
    const context = document.querySelector('#today-context');
    const label = document.querySelector('#selected-day-label');
    const prev = document.querySelector('#prev-day');
    const next = document.querySelector('#next-day');
    const jumpToday = document.querySelector('#jump-today');
    const nextCard = document.querySelector('#next-card');
    const nextKicker = document.querySelector('#next-kicker');
    const nextTitle = document.querySelector('#next-title');
    const nextNote = document.querySelector('#next-note');
    const locateNext = document.querySelector('#locate-next');
    const nextDistance = document.querySelector('#next-distance');

    const pageOpenedAt = new Date();
    const localIso = [pageOpenedAt.getFullYear(), String(pageOpenedAt.getMonth() + 1).padStart(2, '0'), String(pageOpenedAt.getDate()).padStart(2, '0')].join('-');
    let todayIndex = entries.findIndex((entry) => entry.getAttribute('data-date') === localIso);
    let current = todayIndex;

    if (current < 0) {
      current = entries.findIndex((entry) => (entry.getAttribute('data-date') ?? '') > localIso);
      if (current < 0) current = Math.max(0, entries.length - 1);
    }

    function parseMinutes(value) {
      const normalized = value.replace(/^~/, '');
      if (!/^\d{1,2}:\d{2}$/.test(normalized)) return null;
      const [h, m] = normalized.split(':').map(Number);
      return h * 60 + m;
    }

    function setNextTarget(card) {
      if (!(nextCard instanceof HTMLElement)) return;
      const id = card?.getAttribute('data-activity-id') ?? '';
      const query = card?.getAttribute('data-activity-query') ?? '';
      const time = card?.getAttribute('data-activity-time') ?? '';
      nextCard.setAttribute('data-target-activity', id);
      nextCard.setAttribute('data-target-query', query);
      nextCard.setAttribute('data-target-time', time);
      nextCard.toggleAttribute('disabled', !id);
      if (nextDistance) {
        nextDistance.textContent = '';
        nextDistance.classList.add('hidden');
      }
      if (locateNext instanceof HTMLButtonElement) locateNext.disabled = !query;
    }

    function refreshNext(entry) {
      const date = entry.getAttribute('data-date') ?? '';
      const visibleCards = [...entry.querySelectorAll('[data-activity-card]')]
        .filter((card) => !card.closest('[data-variant-panel].hidden'));
      const cards = visibleCards.filter((card) => card.getAttribute('data-completed') !== 'true');

      if (!visibleCards.length) {
        nextKicker.textContent = 'Plan';
        nextTitle.textContent = 'Sin actividades cargadas';
        nextNote.textContent = '';
        setNextTarget(null);
        return;
      }

      if (!cards.length) {
        nextKicker.textContent = 'Hoy';
        nextTitle.textContent = 'Plan completado ✓';
        nextNote.textContent = 'Has marcado todas las paradas de este día como hechas.';
        setNextTarget(null);
        return;
      }

      if (date !== localIso) {
        nextKicker.textContent = date > localIso ? 'Próximo día' : 'Día consultado';
        nextTitle.textContent = cards[0].getAttribute('data-activity-title') ?? 'Primera parada';
        nextNote.textContent = 'Abre este día para consultar el orden completo.';
        setNextTarget(cards[0]);
        return;
      }

      const clock = new Date();
      const currentMinutes = clock.getHours() * 60 + clock.getMinutes();
      const timed = cards
        .map((card) => ({
          card,
          time: card.getAttribute('data-activity-time') ?? '',
          minutes: parseMinutes(card.getAttribute('data-activity-time') ?? ''),
        }))
        .filter((item) => item.minutes !== null);

      const upcoming = timed.find((item) => item.minutes >= currentMinutes);
      if (upcoming) {
        nextKicker.textContent = 'Siguiente';
        nextTitle.textContent = `${upcoming.time} · ${upcoming.card.getAttribute('data-activity-title') ?? ''}`;
        nextNote.textContent = upcoming.time.startsWith('~')
          ? 'Hora aproximada del planning; úsala como guía.'
          : 'Hora fija del planning.';
        setNextTarget(upcoming.card);
        return;
      }

      if (timed.length) {
        nextKicker.textContent = 'Hoy';
        nextTitle.textContent = 'No quedan hitos con hora por delante';
        nextNote.textContent = 'Las actividades sin hora siguen visibles en el orden del día.';
        const untimed = cards.find((card) => !parseMinutes(card.getAttribute('data-activity-time') ?? ''));
        setNextTarget(untimed ?? null);
        return;
      }

      nextKicker.textContent = 'Siguiente del plan';
      nextTitle.textContent = cards[0].getAttribute('data-activity-title') ?? 'Primera parada';
      nextNote.textContent = 'Este día todavía no tiene horas estimadas suficientes para calcularlo por reloj.';
      setNextTarget(cards[0]);
    }

    function show(index) {
      if (!entries.length) return;
      current = Math.max(0, Math.min(index, entries.length - 1));
      entries.forEach((entry, i) => entry.classList.toggle('hidden', i !== current));
      const entry = entries[current];
      const date = entry.getAttribute('data-date') ?? '';
      const city = entry.getAttribute('data-city') ?? '';
      try { if (date) localStorage.setItem('japon2026:selected-date', date); } catch {}
      if (label) label.textContent = entry.getAttribute('data-label') ?? '';
      if (context) {
        context.textContent =
          date === localIso
            ? `Hoy · ${city}`
            : date > localIso
              ? `Viendo un día futuro · ${date}`
              : `Viendo un día anterior · ${date}`;
      }
      if (prev instanceof HTMLButtonElement) prev.disabled = current === 0;
      if (next instanceof HTMLButtonElement) next.disabled = current === entries.length - 1;
      refreshNext(entry);
    }

    function haversineKm(aLat, aLon, bLat, bLon) {
      const toRad = (value) => value * Math.PI / 180;
      const dLat = toRad(bLat - aLat);
      const dLon = toRad(bLon - aLon);
      const lat1 = toRad(aLat);
      const lat2 = toRad(bLat);
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) ** 2;
      return 6371 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
    }

    async function geocodeNext(query) {
      const key = 'japon2026:geocode:' + query.toLocaleLowerCase();
      try {
        const cached = localStorage.getItem(key);
        if (cached) return JSON.parse(cached);
      } catch {}
      const response = await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=jp&q=' + encodeURIComponent(query), {
        headers: { 'Accept-Language': 'en,ja;q=0.8' },
      });
      if (!response.ok) throw new Error('geocode');
      const data = await response.json();
      if (!data.length) throw new Error('not-found');
      const result = { lat: Number(data[0].lat), lon: Number(data[0].lon) };
      try { localStorage.setItem(key, JSON.stringify(result)); } catch {}
      return result;
    }

    locateNext?.addEventListener('click', () => {
      const query = nextCard?.getAttribute('data-target-query') ?? '';
      const time = nextCard?.getAttribute('data-target-time') ?? '';
      if (!query || !nextDistance) return;
      nextDistance.classList.remove('hidden');
      nextDistance.textContent = 'Calculando desde tu ubicación…';

      if (!navigator.geolocation) {
        nextDistance.textContent = 'Este navegador no permite obtener tu ubicación. Usa «Cómo llegar» dentro de la parada.';
        return;
      }

      navigator.geolocation.getCurrentPosition(async ({ coords }) => {
        try {
          const target = await geocodeNext(query);
          const km = haversineKm(coords.latitude, coords.longitude, target.lat, target.lon);
          if (km <= 3) {
            const walkingMinutes = Math.max(3, Math.round(km * 12));
            const parsed = parseMinutes(time);
            let leave = '';
            if (parsed !== null) {
              const departure = parsed - walkingMinutes - 5;
              const h = Math.floor((departure + 1440) % 1440 / 60);
              const m = (departure + 1440) % 60;
              leave = ` · para llegar ${time.replace(/^~/, '')}, salir sobre ${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
            }
            nextDistance.textContent = `≈ ${km.toFixed(1)} km · a pie ~${walkingMinutes} min${leave}. Estimación orientativa; abre Maps para navegación real.`;
          } else {
            nextDistance.textContent = `≈ ${km.toFixed(1)} km en línea recta. Es demasiado lejos para estimar bien a pie: abre «Cómo llegar» en la parada para transporte/navegación real.`;
          }
        } catch {
          nextDistance.textContent = 'No he podido calcular la distancia ahora. Abre «Cómo llegar» dentro de la parada.';
        }
      }, () => {
        nextDistance.textContent = 'No se pudo acceder a tu ubicación. Revisa el permiso del navegador.';
      }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 });
    });

    nextCard?.addEventListener('click', () => {
      const id = nextCard.getAttribute('data-target-activity');
      if (!id) return;
      const entry = entries[current];
      const card = [...entry.querySelectorAll('[data-activity-card]')]
        .find((candidate) => candidate.getAttribute('data-activity-id') === id);
      if (!(card instanceof HTMLElement)) return;
      card.querySelector('details')?.setAttribute('open', '');
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    prev?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    jumpToday?.addEventListener('click', () => {
      if (todayIndex >= 0) show(todayIndex);
      else {
        const nextIndex = entries.findIndex((entry) => (entry.getAttribute('data-date') ?? '') > localIso);
        show(nextIndex >= 0 ? nextIndex : entries.length - 1);
      }
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-variant-button]')) {
        window.setTimeout(() => refreshNext(entries[current]), 0);
      }
    });
    document.addEventListener('japon2026:activity-state', () => {
      const entry = entries[current];
      if (entry) refreshNext(entry);
    });

    show(current);
    window.setInterval(() => {
      const entry = entries[current];
      if (entry) refreshNext(entry);
    }, 60000);
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate, formatDateRange, getTripDateRange } from '../lib/segments';
import { TRIP, TOKYO_MUSTS } from '../data/trip';

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order);
const tripRange = getTripDateRange(segments.map((segment) => segment.data));
const base = import.meta.env.BASE_URL;
---

<Layout title="Japón 2026 · viaje">
  <section class="hero-card overflow-hidden rounded-3xl bg-slate-950 p-6 text-white shadow-xl sm:p-8">
    <p class="text-sm font-bold uppercase tracking-[0.22em] text-red-300">3–28 octubre · 4 viajeros</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl">Japón 2026</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300">{TRIP.summary}</p>
    <div id="trip-now" class="mt-5 rounded-2xl bg-white/10 p-4" data-start={TRIP.start} data-end={TRIP.end}>
      <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Estado</p>
      <p class="mt-1 text-lg font-bold" data-trip-message>Preparando viaje…</p>
    </div>
  </section>

  <section class="mt-6 grid gap-3 sm:grid-cols-2">
    <a href={`${base}hoy/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-2xl">☀️</p><h2 class="mt-2 text-lg font-black">Modo Hoy</h2><p class="mt-1 text-sm text-slate-500">Abre directamente el día actual o el siguiente.</p>
    </a>
    <a href={`${base}mapas/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-2xl">🗺️</p><h2 class="mt-2 text-lg font-black">Mapa + Maps + Tabelog</h2><p class="mt-1 text-sm text-slate-500">Planning completo en mapa, rutas, Apple Maps y Tabelog para comida.</p>
    </a>
  </section>

  <section class="mt-8">
    <div class="mb-3 flex items-end justify-between">
      <div><p class="text-xs font-bold uppercase tracking-widest text-slate-400">Ruta</p><h2 class="text-2xl font-black">Tramos del viaje</h2></div>
      <span class="text-xs text-slate-400">{formatDateRange(tripRange.start, tripRange.end)}</span>
    </div>
    <div class="grid gap-3 md:grid-cols-2">
      {segments.map((segment) => (
        <a href={`${base}viaje/${segment.id}/`} class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <div class="flex items-start justify-between gap-2">
            <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Tramo {segment.data.order}</p><h3 class="text-lg font-black">{segment.data.legLabel ?? segment.data.city}</h3></div>
            <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">{segment.data.days.length} día{segment.data.days.length === 1 ? '' : 's'}</span>
          </div>
          <p class="mt-1 text-sm text-slate-500">{formatDate(segment.data.startDate)} – {formatDate(segment.data.endDate)}</p>
          {segment.data.hotel && <p class="mt-3 text-sm text-slate-700">🏨 {segment.data.hotel.name}</p>}
        </a>
      ))}
    </div>
  </section>

  <section class="mt-8 rounded-3xl border border-red-100 bg-red-50 p-5">
    <p class="text-xs font-bold uppercase tracking-widest text-red-500">Tokio · no perder</p>
    <h2 class="mt-1 text-xl font-black text-slate-950">Las anclas que ya decidimos</h2>
    <ul class="mt-3 grid gap-2 text-sm text-slate-700">
      {TOKYO_MUSTS.map((item) => <li class="flex gap-2"><span>✓</span><span>{item}</span></li>)}
    </ul>
  </section>

  <script>
    const el = document.querySelector('#trip-now');
    const out = el?.querySelector('[data-trip-message]');
    if (el && out) {
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const start = new Date(el.getAttribute('data-start') + 'T00:00:00');
      const end = new Date(el.getAttribute('data-end') + 'T23:59:59');
      const day = 86400000;
      if (today < start) {
        const left = Math.ceil((start.getTime() - today.getTime()) / day);
        out.textContent = left === 1 ? 'Mañana empieza el viaje.' : `Faltan ${left} días.`;
      } else if (today <= end) {
        const n = Math.floor((today.getTime() - start.getTime()) / day) + 1;
        out.textContent = `Día ${n} del viaje · abre “Hoy” para el plan operativo.`;
      } else {
        out.textContent = 'Viaje terminado · el itinerario queda como diario/base histórica.';
      }
    }
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { flattenDays, formatDate, formatDateRange, getTripDateRange, isoDate } from '../lib/segments';
import { TRIP } from '../data/trip';

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order);
const tripRange = getTripDateRange(segments.map((segment) => segment.data));
const days = flattenDays(segments);
const daysMeta = days.map((entry) => ({
  date: isoDate(entry.day.date),
  city: entry.segmentTitle,
  title: entry.day.title ?? entry.segmentTitle,
}));
const base = import.meta.env.BASE_URL;
---

<Layout title="Japón 2026 · viaje">
  <section class="hero-card overflow-hidden rounded-3xl bg-slate-950 p-6 text-white shadow-xl sm:p-8">
    <p class="text-sm font-bold uppercase tracking-[0.22em] text-red-300">3–28 octubre · 4 viajeros</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl">Japón 2026</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300">{TRIP.summary}</p>
    <div class="mt-5 rounded-2xl bg-white/10 p-4">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Ahora</p>
      <p class="mt-1 text-lg font-bold" data-trip-message>Preparando viaje…</p>
      <p class="mt-1 text-xs text-slate-400" data-trip-subtitle></p>
    </div>
  </section>

  <section class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <a href={`${base}hoy/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-2xl">☀️</p><h2 class="mt-2 text-lg font-black">Modo Hoy</h2><p class="mt-1 text-sm text-slate-500">Día actual, siguiente actividad y navegación al día anterior/siguiente.</p>
    </a>
    <a href={`${base}dias/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-2xl">📅</p><h2 class="mt-2 text-lg font-black">Días</h2><p class="mt-1 text-sm text-slate-500">Un día cada vez, sin doom-scrolling.</p>
    </a>
    <a href={`${base}mapas/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-2xl">🗺️</p><h2 class="mt-2 text-lg font-black">Ruta + mapa</h2><p class="mt-1 text-sm text-slate-500">Nuestra ruta Japón 2026, Maps, Apple Maps y Tabelog.</p>
    </a>
    <a href={`${base}recomendaciones/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-2xl">⭐</p><h2 class="mt-2 text-lg font-black">Recomendaciones</h2><p class="mt-1 text-sm text-slate-500">Sitios de Alberto, opciones para 2026 y banco de ideas para otros viajes.</p>
    </a>
  </section>

  <a href={base + "fotos-tokyo-tower/"} class="mt-4 flex items-center justify-between gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 shadow-sm">
    <div><p class="text-xs font-black uppercase tracking-wide text-red-700">📸 Spots Tokyo Tower</p><p class="mt-1 font-black text-slate-950">Mapa de 8 fotos del TikTok</p><p class="mt-1 text-xs text-slate-600">Escaleras, columpio, callejón, cartel y vistas nocturnas.</p></div>
    <span class="shrink-0 text-xl text-red-700">→</span>
  </a>

  <section class="mt-8">
    <div class="mb-3 flex items-end justify-between">
      <div><p class="text-xs font-bold uppercase tracking-widest text-slate-400">Ruta general</p><h2 class="text-2xl font-black">Tramos del viaje</h2></div>
      <span class="text-xs text-slate-400">{formatDateRange(tripRange.start, tripRange.end)}</span>
    </div>
    <div class="grid gap-3 md:grid-cols-2">
      {segments.map((segment) => (
        <a href={`${base}viaje/${segment.id}/`} class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <div class="flex items-start justify-between gap-2">
            <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Tramo {segment.data.order}</p><h3 class="text-lg font-black">{segment.data.legLabel ?? segment.data.city}</h3></div>
            <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">{segment.data.days.length} día{segment.data.days.length === 1 ? '' : 's'}</span>
          </div>
          <p class="mt-1 text-sm text-slate-500">{formatDate(segment.data.startDate)} – {formatDate(segment.data.endDate)}</p>
          {segment.data.hotel && <p class="mt-3 text-sm text-slate-700">🏨 {segment.data.hotel.name}</p>}
        </a>
      ))}
    </div>
  </section>

  <script is:inline define:vars={{ daysMeta, tripStart: TRIP.start, tripEnd: TRIP.end }}>
    const out = document.querySelector('[data-trip-message]');
    const sub = document.querySelector('[data-trip-subtitle]');
    const now = new Date();
    const todayIso = [now.getFullYear(), String(now.getMonth() + 1).padStart(2, '0'), String(now.getDate()).padStart(2, '0')].join('-');
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const start = new Date(tripStart + 'T00:00:00');
    const end = new Date(tripEnd + 'T23:59:59');
    const dayMs = 86400000;

    if (out && sub) {
      if (today < start) {
        const left = Math.ceil((start.getTime() - today.getTime()) / dayMs);
        out.textContent = left === 1 ? 'Mañana empieza el viaje' : `Faltan ${left} días`;
        const next = daysMeta.find((day) => day.date >= todayIso);
        sub.textContent = next ? `Primero: ${next.title}` : '';
      } else if (today <= end) {
        const current = daysMeta.find((day) => day.date === todayIso);
        const n = Math.floor((today.getTime() - start.getTime()) / dayMs) + 1;
        out.textContent = current ? `Día ${n} · ${current.city}` : `Día ${n} del viaje`;
        sub.textContent = current?.title ?? 'Abre Modo Hoy para ver el plan operativo.';
      } else {
        out.textContent = 'Viaje terminado';
        sub.textContent = 'El itinerario queda como base histórica y diario.';
      }
    }
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { RECOMMENDATIONS } from '../data/recommendations';

const scopeMeta = {
  '2026': { label: 'Puede encajar 2026', className: 'bg-blue-100 text-blue-800' },
  future: { label: 'Otro viaje / futuro', className: 'bg-violet-100 text-violet-800' },
  backup: { label: 'Backup', className: 'bg-slate-100 text-slate-700' },
  advice: { label: 'Consejo', className: 'bg-amber-100 text-amber-900' },
};

const priorityMeta = {
  must: { label: 'Sí o sí', className: 'bg-red-600 text-white' },
  try: { label: 'Intentar', className: 'bg-emerald-100 text-emerald-800' },
  optional: { label: 'Opcional', className: 'bg-slate-100 text-slate-700' },
  avoid: { label: 'Evitar', className: 'bg-rose-100 text-rose-800' },
};

const categoryMeta = {
  comida: '🍜 Comida',
  compras: '🛍️ Compras',
  experiencia: '✨ Experiencia',
  excursion: '🚆 Excursión',
  consejo: '💡 Consejo',
};
---

<Layout title="Recomendaciones · Japón 2026">
  <header class="mb-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Banco de ideas</p>
    <h1 class="text-3xl font-black tracking-tight">Recomendaciones</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500">
      Sitios y consejos recogidos de las clases y búsquedas posteriores. Están separados del planning:
      que algo aparezca aquí no significa que vaya automáticamente al itinerario 2026.
    </p>
  </header>

  <section class="mb-5 rounded-2xl border border-violet-200 bg-violet-50 p-4">
    <p class="font-black text-violet-950">🔒 Regla de esta pestaña</p>
    <p class="mt-1 text-sm leading-relaxed text-violet-900">
      <strong>“Otro viaje / futuro” nunca se mete en 2026 por defecto.</strong>
      Por ejemplo, el crucero nocturno por el Sumida está guardado aquí para otro año, no en el planning actual.
    </p>
  </section>

  <div class="sticky top-14 z-30 -mx-4 mb-5 border-y border-slate-200 bg-slate-50/95 px-4 py-3 backdrop-blur">
    <input
      id="recommendation-search"
      type="search"
      placeholder="Buscar Imahan, Nakamoto, Miyajima…"
      class="w-full rounded-xl border border-slate-200 bg-white px-3 py-3 text-base outline-none focus:border-slate-400"
    />
    <div id="recommendation-filters" class="mt-2 flex gap-2 overflow-x-auto pb-1">
      <button type="button" class="rec-filter shrink-0 rounded-full border border-slate-950 bg-slate-950 px-3 py-2 text-xs font-bold text-white" data-scope="all">Todas</button>
      <button type="button" class="rec-filter shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700" data-scope="2026">2026</button>
      <button type="button" class="rec-filter shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700" data-scope="future">Futuro</button>
      <button type="button" class="rec-filter shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700" data-scope="backup">Backup</button>
      <button type="button" class="rec-filter shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700" data-scope="advice">Consejos</button>
    </div>
    <p id="recommendation-count" class="mt-2 text-xs font-semibold text-slate-400">{RECOMMENDATIONS.length} recomendaciones</p>
  </div>

  <div id="recommendation-list" class="grid gap-3 md:grid-cols-2">
    {RECOMMENDATIONS.map((item) => {
      const scope = scopeMeta[item.scope];
      const priority = priorityMeta[item.priority];
      const generatedMaps = item.query
        ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.query)}`
        : undefined;
      const hasMaps = item.links?.some((link) => link.kind === 'maps');
      return (
        <article
          class="recommendation-card rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
          data-scope={item.scope}
          data-search={`${item.title} ${item.area} ${item.category} ${item.summary} ${item.source}`.toLocaleLowerCase()}
        >
          <div class="flex flex-wrap gap-1.5">
            <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-700">{categoryMeta[item.category]}</span>
            <span class:list={['rounded-full px-2 py-1 text-[11px] font-bold', scope.className]}>{scope.label}</span>
            <span class:list={['rounded-full px-2 py-1 text-[11px] font-bold', priority.className]}>{priority.label}</span>
          </div>

          <p class="mt-3 text-xs font-bold uppercase tracking-wide text-slate-400">{item.area}</p>
          <h2 class="mt-1 text-lg font-black text-slate-950">{item.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.summary}</p>

          {item.fit2026 && (
            <div class="mt-3 rounded-xl bg-slate-50 px-3 py-2">
              <p class="text-[11px] font-black uppercase tracking-[0.12em] text-slate-400">Cómo encaja</p>
              <p class="mt-1 text-sm leading-relaxed text-slate-700">{item.fit2026}</p>
            </div>
          )}

          {item.notes?.length && (
            <details class="mt-3 rounded-xl border border-slate-100 bg-white">
              <summary class="cursor-pointer px-3 py-2 text-xs font-bold text-slate-600">Notas</summary>
              <ul class="grid gap-1 px-5 pb-3 text-xs leading-relaxed text-slate-500">
                {item.notes.map((note) => <li>• {note}</li>)}
              </ul>
            </details>
          )}

          <div class="mt-3 flex flex-wrap gap-2">
            {item.links?.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'rounded-xl px-3 py-2 text-xs font-bold',
                  link.kind === 'tabelog' ? 'bg-orange-50 text-orange-800' :
                  link.kind === 'official' ? 'bg-violet-50 text-violet-800' :
                  link.kind === 'menu' ? 'bg-amber-50 text-amber-900' :
                  'bg-blue-50 text-blue-800',
                ]}
              >
                {link.kind === 'tabelog' ? '🍽️' : link.kind === 'official' ? '🌐' : link.kind === 'menu' ? '📋' : '📍'} {link.label}
              </a>
            ))}
            {generatedMaps && !hasMaps && (
              <a href={generatedMaps} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-blue-50 px-3 py-2 text-xs font-bold text-blue-800">📍 Maps</a>
            )}
          </div>

          <p class="mt-3 text-[11px] font-semibold text-slate-400">Fuente: {item.source}</p>
        </article>
      );
    })}
  </div>

  <p id="recommendation-empty" class="hidden rounded-2xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500">
    No hay recomendaciones que coincidan con ese filtro.
  </p>

  <script>
    const cards = [...document.querySelectorAll('.recommendation-card')];
    const filters = [...document.querySelectorAll('.rec-filter')];
    const search = document.querySelector('#recommendation-search');
    const count = document.querySelector('#recommendation-count');
    const empty = document.querySelector('#recommendation-empty');
    let activeScope = 'all';

    function refresh() {
      const q = search instanceof HTMLInputElement ? search.value.trim().toLocaleLowerCase() : '';
      let visible = 0;

      cards.forEach((card) => {
        const scope = card.getAttribute('data-scope') ?? '';
        const haystack = card.getAttribute('data-search') ?? '';
        const matchesScope = activeScope === 'all' || scope === activeScope;
        const matchesSearch = !q || haystack.includes(q);
        const show = matchesScope && matchesSearch;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (count) count.textContent = `${visible} recomendación${visible === 1 ? '' : 'es'}`;
      empty?.classList.toggle('hidden', visible !== 0);
    }

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        activeScope = button.getAttribute('data-scope') ?? 'all';
        filters.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('bg-slate-950', active);
          candidate.classList.toggle('text-white', active);
          candidate.classList.toggle('border-slate-950', active);
          candidate.classList.toggle('bg-white', !active);
          candidate.classList.toggle('text-slate-700', !active);
          candidate.classList.toggle('border-slate-200', !active);
        });
        refresh();
      });
    });

    search?.addEventListener('input', refresh);
  </script>
</Layout>

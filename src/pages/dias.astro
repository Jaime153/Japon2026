---
import Layout from '../layouts/Layout.astro';
import DayBlock from '../components/DayBlock.astro';
import { getCollection } from 'astro:content';
import { flattenDays, formatDayHeading, isoDate } from '../lib/segments';

const segments = (await getCollection('segments')).sort((a, b) => a.data.order - b.data.order);
const days = flattenDays(segments);
---

<Layout title="Días · Japón 2026">
  <header class="mb-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Timeline</p>
    <h1 class="text-3xl font-black tracking-tight">Días</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500">Un día cada vez: sin cascada infinita. Desliza las fechas o usa anterior/siguiente.</p>
  </header>

  <div class="sticky top-14 z-30 -mx-4 mb-5 border-y border-slate-200 bg-slate-50/95 px-4 py-3 backdrop-blur">
    <div id="day-chips" class="flex gap-2 overflow-x-auto pb-1">
      {days.map((entry, index) => (
        <button
          type="button"
          class="day-chip shrink-0 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700"
          data-day-index={index}
          data-day-date={isoDate(entry.day.date)}
        >
          {new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(entry.day.date)}
        </button>
      ))}
    </div>
    <div class="mt-3 grid grid-cols-[auto_1fr_auto] items-center gap-2">
      <button id="prev-day" type="button" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold">←</button>
      <p id="selected-day-label" class="text-center text-sm font-black text-slate-900"></p>
      <button id="next-day" type="button" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold">→</button>
    </div>
  </div>

  <div id="day-panels">
    {days.map((entry, index) => (
      <div class="day-panel hidden" data-day-index={index} data-day-date={isoDate(entry.day.date)} data-day-label={`${formatDayHeading(entry.day.date)} · ${entry.segmentTitle}`}>
        <DayBlock day={entry.day} city={entry.segmentTitle} alternatives={entry.alternatives} />
      </div>
    ))}
  </div>

  <script>
    const panels = [...document.querySelectorAll('.day-panel')];
    const chips = [...document.querySelectorAll('.day-chip')];
    const label = document.querySelector('#selected-day-label');
    const prev = document.querySelector('#prev-day');
    const next = document.querySelector('#next-day');

    const now = new Date();
    const today = [now.getFullYear(), String(now.getMonth() + 1).padStart(2, '0'), String(now.getDate()).padStart(2, '0')].join('-');
    let current = Math.max(0, panels.findIndex((panel) => (panel.getAttribute('data-day-date') ?? '') >= today));
    if (current < 0) current = panels.length - 1;

    function show(index) {
      if (!panels.length) return;
      current = Math.max(0, Math.min(index, panels.length - 1));
      panels.forEach((panel, i) => panel.classList.toggle('hidden', i !== current));
      chips.forEach((chip, i) => {
        const active = i === current;
        chip.classList.toggle('bg-slate-950', active);
        chip.classList.toggle('text-white', active);
        chip.classList.toggle('bg-white', !active);
        chip.classList.toggle('text-slate-700', !active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      const activePanel = panels[current];
      if (label) label.textContent = activePanel?.getAttribute('data-day-label') ?? '';
      chips[current]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      if (prev instanceof HTMLButtonElement) prev.disabled = current === 0;
      if (next instanceof HTMLButtonElement) next.disabled = current === panels.length - 1;
    }

    chips.forEach((chip, index) => chip.addEventListener('click', () => show(index)));
    prev?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    show(current);
  </script>
</Layout>

---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Itinerario del viaje a Japón, octubre 2026." />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <Nav />
    <main class="mx-auto max-w-2xl px-4 py-6 pb-16">
      <slot />
    </main>
  </body>
</html>

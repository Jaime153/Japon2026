---
const currentPath = new URL(Astro.request.url).pathname;
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}hoy/`, label: 'Hoy', icon: '☀️' },
  { href: `${base}dias/`, label: 'Días', icon: '📅' },
  { href: `${base}mapas/`, label: 'Mapas', icon: '🗺️' },
  { href: `${base}info/`, label: 'Info', icon: '🎒' },
];
function active(href: string) { return currentPath === href || currentPath === href.replace(/\/$/, ''); }
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
    <a href={base} class="font-black tracking-tight text-slate-950">🇯🇵 Japón 2026</a>
    <nav class="hidden gap-1 sm:flex">
      {links.map((link) => <a href={link.href} class:list={['rounded-xl px-3 py-2 text-sm font-semibold', active(link.href) ? 'bg-slate-950 text-white' : 'text-slate-600 hover:bg-slate-100']}>{link.icon} {link.label}</a>)}
    </nav>
  </div>
</header>

<nav class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white/95 px-2 pb-[max(.5rem,env(safe-area-inset-bottom))] pt-2 backdrop-blur-xl sm:hidden">
  <ul class="mx-auto grid max-w-md grid-cols-4 gap-1">
    {links.map((link) => <li><a href={link.href} class:list={['flex min-h-12 flex-col items-center justify-center rounded-xl text-[11px] font-bold', active(link.href) ? 'bg-slate-950 text-white' : 'text-slate-600']}><span class="text-lg" aria-hidden="true">{link.icon}</span>{link.label}</a></li>)}
  </ul>
</nav>

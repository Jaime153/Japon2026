---
import ActivityCard from './ActivityCard.astro';
import { STATUS_META } from '../lib/categories';
import { formatDayHeading, isoDate } from '../lib/segments';
import type { CollectionEntry } from 'astro:content';

type Day = CollectionEntry<'segments'>['data']['days'][number];
interface Props { day: Day; city?: string; compact?: boolean; }
const { day, city, compact = false } = Astro.props;
const status = STATUS_META[day.status];
---

<section class="day-block scroll-mt-20" data-date={isoDate(day.date)}>
  <div class="mb-3 flex items-start justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">{formatDayHeading(day.date)}{city ? ` · ${city}` : ''}</p>
      <h2 class="mt-1 text-xl font-black tracking-tight text-slate-950">{day.title ?? formatDayHeading(day.date)}</h2>
    </div>
    <span class:list={['shrink-0 rounded-full px-2 py-1 text-[11px] font-bold', status.className]}>{status.label}</span>
  </div>
  {day.note && <p class="mb-3 rounded-xl bg-slate-100 px-3 py-2 text-sm leading-relaxed text-slate-600">{day.note}</p>}
  <ul class="grid gap-3">{day.activities.map((activity) => <ActivityCard activity={activity} compact={compact} />)}</ul>
</section>

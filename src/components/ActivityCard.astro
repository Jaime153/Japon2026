---
import { CATEGORY_META } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

type Activity = CollectionEntry<'segments'>['data']['days'][number]['activities'][number];

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;
const meta = CATEGORY_META[activity.category];

const LINK_BUTTONS = [
  { key: 'googleMaps', icon: '📍', label: 'Google Maps', class: 'bg-sky-50 text-sky-700 hover:bg-sky-100' },
  { key: 'appleMaps', icon: '🗺️', label: 'Apple Maps', class: 'bg-sky-50 text-sky-700 hover:bg-sky-100' },
  { key: 'tabelog', icon: '🍽️', label: 'Tabelog', class: 'bg-sky-50 text-sky-700 hover:bg-sky-100' },
  { key: 'officialWebsite', icon: '🌐', label: 'Web oficial', class: 'bg-sky-50 text-sky-700 hover:bg-sky-100' },
  { key: 'reservation', icon: '🎫', label: 'Reservar', class: 'bg-amber-50 text-amber-700 hover:bg-amber-100' },
] as const;

const linkButtons = LINK_BUTTONS.filter((button) => activity.links?.[button.key]);
---

<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-medium text-slate-900">{activity.title}</h3>
    {activity.time && <span class="shrink-0 text-sm font-medium text-slate-500">{activity.time}</span>}
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-2">
    <span class:list={['inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium', meta.className]}>
      <span aria-hidden="true">{meta.icon}</span>
      {meta.label}
    </span>
  </div>

  {activity.notes && <p class="mt-2 text-sm text-slate-600">{activity.notes}</p>}

  {
    (activity.address || activity.nearestStation || activity.duration || activity.approximatePrice || activity.reservationRequired) && (
      <dl class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
        {activity.address && (
          <div class="flex min-w-0 gap-1">
            <dt class="shrink-0 font-medium" aria-hidden="true">📌</dt>
            <dd class="break-words"><span class="sr-only">Dirección: </span>{activity.address}</dd>
          </div>
        )}
        {activity.nearestStation && (
          <div class="flex min-w-0 gap-1">
            <dt class="shrink-0 font-medium" aria-hidden="true">🚉</dt>
            <dd class="break-words"><span class="sr-only">Estación cercana: </span>{activity.nearestStation}</dd>
          </div>
        )}
        {activity.duration && (
          <div class="flex min-w-0 gap-1">
            <dt class="shrink-0 font-medium" aria-hidden="true">⏱️</dt>
            <dd class="break-words"><span class="sr-only">Duración: </span>{activity.duration}</dd>
          </div>
        )}
        {activity.approximatePrice && (
          <div class="flex min-w-0 gap-1">
            <dt class="shrink-0 font-medium" aria-hidden="true">💴</dt>
            <dd class="break-words"><span class="sr-only">Precio aproximado: </span>{activity.approximatePrice}</dd>
          </div>
        )}
        {activity.reservationRequired && (
          <div class="flex min-w-0 gap-1 font-medium text-amber-600">
            <dt class="shrink-0" aria-hidden="true">⚠️</dt>
            <dd class="break-words">Reserva requerida</dd>
          </div>
        )}
      </dl>
    )
  }

  {
    linkButtons.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {linkButtons.map((button) => (
          <a
            href={activity.links![button.key]}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['inline-flex items-center gap-1 rounded-full px-3 py-2.5 text-sm font-medium', button.class]}
          >
            <span aria-hidden="true">{button.icon}</span> {button.label}
          </a>
        ))}
      </div>
    )
  }
</li>

---
import { CATEGORY_META, STATUS_META } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

type Activity = CollectionEntry<'segments'>['data']['days'][number]['activities'][number];
interface Props { activity: Activity; compact?: boolean; }

const { activity, compact = false } = Astro.props;
const meta = CATEGORY_META[activity.category];
const status = STATUS_META[activity.status];
const query = activity.locationQuery ?? activity.address ?? activity.title;
const googleMapsUrl = activity.bathChoices ? undefined : activity.links?.googleMaps ?? (query ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}` : undefined);
const appleMapsUrl = activity.bathChoices ? undefined : activity.links?.appleMaps ?? (query ? `https://maps.apple.com/?q=${encodeURIComponent(query)}` : undefined);
const directionsUrl = activity.bathChoices ? undefined : query ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(query)}` : undefined;
// El envío de equipaje tiene dos oficinas: la de entrega en Tokio y la de recogida en Osaka.
// En este caso nunca mostramos un botón genérico de Maps que pueda confundir ambas.
const hasTwoYamatoMaps = Boolean(activity.links?.originMaps && activity.links?.destinationMaps);
const tabelogUrl = activity.links?.tabelog ?? (activity.category === 'comida'
  ? `https://tabelog.com/en/rstLst/?vs=1&sk=${encodeURIComponent(activity.title)}`
  : undefined);
const flightRouteSummary = activity.flightJourney
  ? activity.flightJourney.legs.map((leg, index) => index === 0
      ? `${leg.departure.code} ${leg.departure.terminal} → ${leg.arrival.code} ${leg.arrival.terminal}`
      : `→ ${leg.arrival.code} ${leg.arrival.terminal}`
    ).join(' ')
  : undefined;

const hasExtra = Boolean(
  activity.flightJourney ||
  activity.description ||
  activity.parking ||
  activity.bathChoices ||
  activity.choices ||
  activity.transit ||
  activity.plan?.length ||
  activity.notes ||
  activity.address ||
  activity.nearestStation ||
  activity.duration ||
  activity.approximatePrice ||
  activity.reservationRequired ||
  googleMapsUrl ||
  activity.links?.originMaps ||
  activity.links?.destinationMaps ||
  appleMapsUrl ||
  directionsUrl ||
  tabelogUrl ||
  activity.links?.officialWebsite ||
  activity.links?.photoSpots ||
  activity.links?.reservation ||
  activity.links?.weather ||
  activity.links?.weatherAlt ||
  activity.links?.liveCam
);
---

<li
  class:list={['activity-card overflow-hidden rounded-2xl border bg-white shadow-sm', activity.priority === 'must' ? 'border-red-200 ring-1 ring-red-100' : 'border-slate-200']}
  data-activity-card
  data-activity-id={activity.id}
  data-activity-title={activity.title}
  data-activity-time={activity.time ?? ''}
  data-activity-status={activity.status}
  data-activity-skipped={activity.skipped ? 'true' : 'false'}
  data-activity-query={query ?? ''}
  data-completed={activity.visited ? 'true' : 'false'}
>
  <details class="activity-details group">
    <summary class:list={['cursor-pointer list-none select-none', compact ? 'p-3' : 'p-4']}>
      <div class="min-w-0">
        <div class="flex min-w-0 flex-wrap items-center gap-1.5">
          <span class:list={['inline-flex max-w-full rounded-full px-2 py-0.5 text-[11px] font-semibold', meta.className]}>{meta.icon} {meta.label}</span>
          {activity.status === 'opcional' || activity.status === 'pendiente' || (activity.status === 'confirmado' && !activity.visited && activity.category !== 'templo') ? (
            <span class:list={['inline-flex max-w-full rounded-full px-2 py-0.5 text-[11px] font-semibold', status.className]}>{status.label}</span>
          ) : null}
          {activity.priority === 'must' && !activity.visited && <span class="inline-flex rounded-full bg-red-600 px-2 py-0.5 text-[11px] font-semibold text-white">Sí o sí</span>}
          {activity.id === 'kyoto-station-h2' && <span class="inline-flex rounded-full bg-red-700 px-2 py-1 text-[11px] font-black text-white">🚌 SUBIDA · H2/KY2</span>}
          {activity.id === 'kix-vilma-marga' && <span class="inline-flex rounded-full bg-red-700 px-2 py-1 text-[11px] font-black text-white">✈️ KIX · TERMINAL 1</span>}
          {activity.goshuin === true && <span class="inline-flex rounded-full bg-violet-100 px-2 py-0.5 text-[11px] font-semibold text-violet-800">📕 Goshuin</span>}
          {activity.goshuin === false && <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">Sin goshuin</span>}
          {activity.skipped && <span class="inline-flex rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-700">No fuimos</span>}

          {activity.time && <span class="inline-flex max-w-full items-center rounded-lg bg-slate-950 px-2 py-1 text-xs font-bold leading-snug text-white whitespace-normal break-words">{activity.time}</span>}
          <span class="activity-chevron ml-auto shrink-0 text-lg leading-none text-slate-400" aria-hidden="true">⌄</span>
        </div>
        <h3 class="mt-2 min-w-0 break-words text-base font-semibold leading-snug text-slate-950">{activity.title}</h3>
        {activity.choices && (
          <p class="mt-1 text-xs font-bold text-orange-700" data-choice-current>➜ {activity.choices.options.find(o => o.id === activity.choices?.defaultId)?.name}</p>
        )}
        {flightRouteSummary && <p class="mt-1 text-xs font-black text-slate-500">{flightRouteSummary}</p>}
        {hasExtra && (
          <p class="mt-1 text-xs font-semibold text-slate-400 group-open:hidden">Toca para ver qué hacer y acciones</p>
        )}
      </div>
    </summary>

    <div class:list={['border-t border-slate-100', compact ? 'px-3 pb-3 pt-3' : 'px-4 pb-4 pt-3']}>
      {activity.id === 'kyoto-station-h2' && (
        <div class="mb-3 rounded-xl border-2 border-red-500 bg-red-50 p-3" data-kix-h2-pickup>
          <p class="text-sm font-black text-red-900">🔴 SUBIDA AIRPORT LIMOUSINE · H2 / KY2</p>
          <p class="mt-1 text-sm font-semibold text-red-950">Kyoto Station, salida Hachijō-guchi · junto a Kyoto Avanti</p>
          <p class="mt-1 text-xs font-bold text-red-900">Pin exacto: 34.983902, 135.760799</p>
          <p class="mt-2 text-xs leading-relaxed text-red-900">H2 es para SUBIR. H3 es para BAJAR y no sirve para coger el autobús. No usar «Kyoto Station» genérico ni KIX como destino del taxi.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href="https://www.google.com/maps/dir/?api=1&destination=34.983902%2C135.760799&travelmode=driving" target="_blank" rel="noopener noreferrer" class="tap-target rounded-lg bg-red-700 px-3 py-2 text-sm font-bold text-white">🚕 Taxi al H2 exacto</a>
            <a href="https://www.google.com/maps/dir/?api=1&destination=34.983902%2C135.760799&travelmode=transit" target="_blank" rel="noopener noreferrer" class="tap-target rounded-lg border border-red-300 bg-white px-3 py-2 text-sm font-bold text-red-900">🚌 Transporte público al H2</a>
            <a href="https://www.kate.co.jp/en/busstop/detail/4330" target="_blank" rel="noopener noreferrer" class="tap-target rounded-lg border border-red-300 bg-white px-3 py-2 text-sm font-bold text-red-900">Parada oficial KATE</a>
          </div>
        </div>
      )}
      {activity.id === 'kix-vilma-marga' && (
        <div class="mb-3 rounded-xl border-2 border-red-500 bg-red-50 p-3" data-kix-terminal-one>
          <p class="text-sm font-black text-red-900">🔴 AEROPUERTO KIX · TERMINAL 1 (T1)</p>
          <p class="mt-1 text-xs leading-relaxed text-red-900">Destino del autobús y salida del vuelo de las 19:00. Vosotros acompañáis a Vilma y Marga solo hasta la parada H2/KY2 de Kioto.</p>
        </div>
      )}
      {activity.flightJourney && (
        <div class="rounded-2xl border border-sky-200 bg-sky-50/70 p-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-xs font-black uppercase tracking-[0.12em] text-sky-700">Itinerario de vuelo</p>
            {activity.flightJourney.travellers?.length && (
              <span class="rounded-full bg-white px-2 py-1 text-[11px] font-bold text-slate-600">
                {activity.flightJourney.travellers.join(' · ')}
              </span>
            )}
          </div>

          <div class="mt-3 grid gap-3">
            {activity.flightJourney.legs.map((leg, index) => (
              <>
                <div class="rounded-xl bg-white p-3 shadow-sm">
                  <div class="flex flex-wrap items-start justify-between gap-2">
                    <div>
                      <p class="text-sm font-black text-slate-950">✈️ {leg.flightNumber} · {leg.airline}</p>
                      {leg.operatedBy && <p class="mt-0.5 text-xs text-slate-500">Operado por {leg.operatedBy}</p>}
                    </div>
                    {leg.duration && <span class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600">{leg.duration}</span>}
                  </div>
                  <div class="mt-3 grid grid-cols-[1fr_auto_1fr] items-center gap-2">
                    <div>
                      <p class="text-lg font-black">{leg.departure.code} · {leg.departure.terminal}</p>
                      <p class="text-xs text-slate-500">{leg.departure.date} · {leg.departure.time}</p>
                    </div>
                    <span class="text-slate-300">→</span>
                    <div class="text-right">
                      <p class="text-lg font-black">{leg.arrival.code} · {leg.arrival.terminal}</p>
                      <p class="text-xs text-slate-500">{leg.arrival.date} · {leg.arrival.time}</p>
                    </div>
                  </div>
                </div>

                {activity.flightJourney.connections?.[index] && (
                  <div class="rounded-xl border border-dashed border-sky-200 bg-white/70 px-3 py-2 text-sm text-slate-600">
                    <strong>🔁 Escala {activity.flightJourney.connections[index].duration}</strong>
                    {' · '}{activity.flightJourney.connections[index].airport} {activity.flightJourney.connections[index].terminal}
                    {activity.flightJourney.connections[index].sameTerminal && <span> · misma terminal</span>}
                    {activity.flightJourney.connections[index].note && <p class="mt-1 text-xs">{activity.flightJourney.connections[index].note}</p>}
                  </div>
                )}
              </>
            ))}
          </div>

          {activity.flightJourney.checkInNote && <p class="mt-3 text-xs leading-relaxed text-sky-950">🧳 {activity.flightJourney.checkInNote}</p>}
          {activity.flightJourney.verificationNote && <p class="mt-2 text-[11px] leading-relaxed text-slate-500">ℹ️ {activity.flightJourney.verificationNote}</p>}
        </div>
      )}

      {activity.parking && (
        <div class="mt-3 rounded-2xl border border-sky-200 bg-sky-50 p-3" data-parking-info>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-xs font-black uppercase tracking-[0.12em] text-sky-900">🅿️ Aparcamiento para esta parada</p>
            {activity.parking.arrived && <span class="rounded-full bg-emerald-100 px-2 py-1 text-[11px] font-bold text-emerald-900">✓ Ya aparcados</span>}
          </div>
          <p class="mt-2 text-sm font-bold text-slate-950">{activity.parking.name}</p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <div class="rounded-xl bg-white px-3 py-2">
              <p class="text-[10px] font-bold uppercase text-slate-500">MAPCODE · navegador del coche</p>
              <code class="text-lg font-black tracking-wide text-slate-950">{activity.parking.mapcode}</code>
            </div>
            <button type="button" data-parking-mapcode={activity.parking.mapcode} class="tap-target rounded-xl border border-sky-300 bg-white px-3 py-3 text-sm font-bold text-sky-900">📋 Copiar código</button>
          </div>
          {activity.parking.kind === 'reference' && (
            <p class="mt-2 text-xs font-bold text-amber-800">⚠️ Código de referencia: NO garantiza que señale la entrada del aparcamiento.</p>
          )}
          {activity.parking.notes && <p class="mt-2 text-xs leading-relaxed text-slate-600">{activity.parking.notes}</p>}
          <div class="mt-3 flex flex-wrap gap-2">
            <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(activity.parking.mapsQuery)}`} target="_blank" rel="noopener noreferrer" class="tap-target rounded-xl bg-blue-700 px-3 py-2 text-sm font-bold text-white">🅿️ Ir al parking</a>
            {activity.parking.spotQuery && (
              <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(activity.parking.spotQuery)}`} target="_blank" rel="noopener noreferrer" class="tap-target rounded-xl bg-amber-100 px-3 py-2 text-sm font-bold text-amber-900">📸 Ir a la calle · a pie</a>
            )}
            <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(activity.parking.mapsQuery)}&travelmode=driving`} target="_blank" rel="noopener noreferrer" class="tap-target rounded-xl bg-emerald-100 px-3 py-2 text-sm font-bold text-emerald-900">🚗 Ruta al parking</a>
          </div>
          {activity.parking.sourceUrl && <a href={activity.parking.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-[11px] font-semibold text-sky-700 underline">Ficha de referencia</a>}
        </div>
      )}

      {activity.choices && (
        <section class="mb-3 rounded-xl border border-orange-200 bg-orange-50/60 p-2" data-choice-selector data-default-option={activity.choices.defaultId} aria-label={activity.choices.label}>
          <p class="px-1 text-[11px] font-black uppercase tracking-[0.12em] text-orange-800">{activity.choices.label}</p>
          <div class="mt-1.5 flex gap-1.5 overflow-x-auto pb-1" role="group">
            {activity.choices.options.map((option) => (
              <button
                type="button"
                data-choice={option.id}
                data-choice-name={option.name}
                data-choice-query={option.locationQuery}
                aria-pressed={option.id === activity.choices?.defaultId ? 'true' : 'false'}
                class:list={['shrink-0 whitespace-nowrap rounded-full border px-3 py-1.5 text-xs font-bold', option.id === activity.choices?.defaultId ? 'border-slate-950 bg-slate-950 text-white' : 'border-orange-200 bg-white text-slate-700']}
              >{option.name}</button>
            ))}
          </div>
          {activity.choices.options.map((option) => (
            <div data-choice-panel={option.id} class:list={['mt-1 px-1 text-xs leading-snug text-slate-700', option.id !== activity.choices?.defaultId && 'hidden']}>
              <p class="font-semibold">{[option.price && `💴 ${option.price}`, option.hours && `🕒 ${option.hours}`].filter(Boolean).join(' · ')}</p>
              {option.note && <p class="mt-0.5 text-slate-600">{option.note}</p>}
              {option.url && <a href={option.url} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block font-bold text-violet-800 underline">Web</a>}
            </div>
          ))}
        </section>
      )}

      {activity.transit && (
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-xs font-black uppercase tracking-[0.12em] text-emerald-800">Cómo llegar previsto</p>
            {activity.transit.approximateDuration && <span class="rounded-lg bg-white px-2 py-1 text-[11px] font-bold text-emerald-800">~{activity.transit.approximateDuration}</span>}
          </div>
          {activity.transit.from && <p class="mt-1 text-[11px] font-bold text-emerald-700">Desde: {activity.transit.from}</p>}
          <p class="mt-2 text-sm font-semibold leading-relaxed text-slate-800">{activity.transit.summary}</p>
          {activity.transit.steps?.length && (
            <ol class="mt-2 grid gap-1.5 text-sm leading-relaxed text-slate-700">
              {activity.transit.steps.map((step, index) => <li><strong>{index + 1}.</strong> {step}</li>)}
            </ol>
          )}
          {activity.transit.note && <p class="mt-2 text-xs leading-relaxed text-slate-500">ℹ️ {activity.transit.note}</p>}
        </div>
      )}

      {activity.plan?.length && (
        <div class:list={[activity.transit ? 'mt-3' : '', 'rounded-xl bg-slate-50 p-3']}>
          <p class="text-xs font-black uppercase tracking-[0.12em] text-slate-400">Qué hacer aquí</p>
          <ol class="mt-2 grid gap-1.5 text-sm leading-relaxed text-slate-700">
            {activity.plan.map((step, index) => <li><strong>{index + 1}.</strong> {step}</li>)}
          </ol>
        </div>
      )}

      {activity.bathChoices && (
        <section class="mt-3 rounded-2xl border border-slate-200 bg-white p-3" data-bath-selector data-default-option={activity.bathChoices.defaultId} aria-label="Elegir modalidad del baño">
          <p class="text-sm font-black text-slate-950">♨️ Elige un baño</p>
          <p class="mt-1 text-xs leading-relaxed text-slate-600">
            Primero volvéis al RESI para desmaquillaros. Después elegís uno de estos tres baños públicos (separados por sexo). El mapa seguirá vuestra elección.
          </p>
          <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3" role="group" aria-label="Tipo de baño">
            {activity.bathChoices.options.map((option) => (
              <button
                type="button"
                data-bath-choice={option.id}
                aria-pressed={option.id === activity.bathChoices?.defaultId ? 'true' : 'false'}
                class:list={['tap-target rounded-xl border px-3 py-3 text-left text-sm font-bold', option.id === activity.bathChoices?.defaultId ? 'border-slate-950 bg-slate-950 text-white' : 'border-slate-200 bg-slate-50 text-slate-700']}
              >♨️ {option.label}</button>
            ))}
          </div>
          {activity.bathChoices.options.map((option) => (
            <div data-bath-panel={option.id} class:list={['mt-3 rounded-xl bg-slate-50 p-3', option.id !== activity.bathChoices?.defaultId && 'hidden']}>
              <p class="break-words text-base font-black">{option.venue}</p>
              <p class="mt-1 text-xs font-bold text-slate-600">{option.evidence === 'official' ? 'Tatuajes permitidos · web del local' : option.evidence === 'tourism' ? 'Tatuajes permitidos · guía turística oficial de Kioto' : 'Consultar política de tatuajes'}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-800">{option.policy}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{option.practical}</p>
              {option.fromHotelDuration && (
                <div class="mt-3 rounded-xl border border-blue-100 bg-blue-50 p-3">
                  <p class="text-sm font-bold text-blue-950">🚌 Desde RESI STAY Yasaka: {option.fromHotelDuration}</p>
                  {option.fromHotelDirections && <p class="mt-1 text-sm leading-relaxed text-slate-700">{option.fromHotelDirections}</p>}
                  <p class="mt-1 text-xs text-slate-500">Tiempo aproximado, incluye esperas y caminatas. Comprueba la salida real.</p>
                  {option.fromHotelMapsUrl && <a href={option.fromHotelMapsUrl} target="_blank" rel="noopener noreferrer" class="tap-target mt-2 inline-flex items-center rounded-xl bg-white px-3 py-2 text-sm font-bold text-blue-900">🚌 Ruta en transporte público desde el hotel</a>}
                </div>
              )}
              {option.price && <p class="mt-2 text-xs font-semibold">💴 {option.price}</p>}
              {option.hours && <p class="mt-1 text-xs font-semibold">🕒 {option.hours}</p>}
              <div class="mt-3 flex flex-wrap gap-2">
                <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(option.locationQuery)}`} target="_blank" rel="noopener noreferrer" class="tap-target rounded-xl bg-blue-50 px-3 py-2 text-sm font-bold text-blue-900">📍 Ver ubicación</a>
                <a href={option.officialUrl} target="_blank" rel="noopener noreferrer" class="tap-target rounded-xl bg-white px-3 py-2 text-sm font-bold text-slate-800">🌐 Web oficial</a>
                {option.bookingUrl && <a href={option.bookingUrl} target="_blank" rel="noopener noreferrer" class="tap-target rounded-xl bg-amber-100 px-3 py-2 text-sm font-bold text-amber-900">📞 Consultar reserva</a>}
              </div>
            </div>
          ))}
          <p data-bath-saved class="mt-2 hidden text-xs font-semibold text-emerald-800">✓ Preferencia guardada en este dispositivo</p>
        </section>
      )}

      {activity.description && (
        <div class="mt-3 rounded-xl border border-amber-100 bg-amber-50/60 p-3">
          <p class="text-xs font-black uppercase tracking-[0.12em] text-amber-800">⛩️ Historia y significado</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">{activity.description}</p>
        </div>
      )}

      {activity.notes && (
        <div class="mt-3">
          <p class="text-xs font-black uppercase tracking-[0.12em] text-slate-400">Observaciones</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">{activity.notes}</p>
        </div>
      )}

      {(activity.address || activity.nearestStation || activity.duration || activity.approximatePrice || activity.reservationRequired) && (
        <dl class="mt-3 grid gap-1 text-xs text-slate-500">
          {activity.address && <div><dt class="sr-only">Dirección</dt><dd>📌 {activity.address}</dd></div>}
          {activity.nearestStation && <div><dt class="sr-only">Estación</dt><dd>🚉 {activity.nearestStation}</dd></div>}
          {activity.duration && <div><dt class="sr-only">Duración</dt><dd>⏱️ {activity.duration}</dd></div>}
          {activity.approximatePrice && <div><dt class="sr-only">Precio</dt><dd>💴 {activity.approximatePrice}</dd></div>}
          {activity.reservationRequired && <div class="font-semibold text-amber-700">⚠️ Reserva/entrada necesaria</div>}
        </dl>
      )}

      {(googleMapsUrl || appleMapsUrl || directionsUrl || activity.links?.originMaps || activity.links?.destinationMaps || tabelogUrl || activity.links?.officialWebsite || activity.links?.photoSpots || activity.links?.reservation || activity.links?.weather || activity.links?.weatherAlt || activity.links?.liveCam) && (
        <div class="mt-3 flex flex-wrap gap-2">
          {hasTwoYamatoMaps ? (
            <>
              <a href={activity.links?.originMaps} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-emerald-50 px-3 py-2 text-sm font-bold text-emerald-900">📦 Tokio · Entregar maletas</a>
              <a href={activity.links?.destinationMaps} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-blue-50 px-3 py-2 text-sm font-bold text-blue-900">📍 Osaka · Recoger maletas</a>
              {directionsUrl && <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-800">🧭 Ruta a Yamato Tokio</a>}
            </>
          ) : (
            <>
              {!activity.parking?.spotQuery && googleMapsUrl && <a data-choice-link="maps" href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-800">📍 Google Maps</a>}
              {!activity.parking?.spotQuery && directionsUrl && <a data-choice-link="dir" href={directionsUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800">🧭 Cómo llegar</a>}
              {!activity.parking?.spotQuery && appleMapsUrl && <a data-choice-link="apple" href={appleMapsUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-800"> Maps</a>}
            </>
          )}
          {tabelogUrl && <a data-choice-link="tabelog" href={tabelogUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-orange-50 px-3 py-2 text-sm font-semibold text-orange-800">🍽️ Tabelog</a>}
          {!activity.bathChoices && activity.links?.officialWebsite && <a href={activity.links.officialWebsite} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-violet-50 px-3 py-2 text-sm font-semibold text-violet-800">🌐 Web oficial</a>}
          {activity.links?.photoSpots && <a href={activity.links.photoSpots} class="tap-target inline-flex items-center gap-1 rounded-xl bg-red-50 px-3 py-2 text-sm font-bold text-red-800">📸 Ver mapa de los 8 spots</a>}
          {activity.links?.reservation && <a href={activity.links.reservation} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900">🎫 Reservar</a>}
          {activity.links?.weather && <a href={activity.links.weather} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-900">🌤️ Weathernews</a>}
          {activity.links?.weatherAlt && <a href={activity.links.weatherAlt} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-900">☁️ JMA / Open-Meteo</a>}
          {activity.links?.liveCam && <a href={activity.links.liveCam} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-cyan-50 px-3 py-2 text-sm font-semibold text-cyan-900">📷 Fuji en directo</a>}
        </div>
      )}

      <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-3">
        <label class="block text-xs font-black uppercase tracking-[0.12em] text-slate-400" for={`note-${activity.id}`}>Mi nota</label>
        <textarea
          id={`note-${activity.id}`}
          data-personal-note
          rows="2"
          placeholder="Apunta algo para este sitio…"
          class="mt-2 w-full resize-y rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 outline-none focus:border-slate-400"
        ></textarea>
        <p data-note-saved class="mt-1 hidden text-[11px] font-semibold text-emerald-700">Guardado en este dispositivo</p>
      </div>

      <button
        type="button"
        data-complete-toggle
        class="mt-3 inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-slate-700"
      >
        ✓ Marcar como hecho
      </button>
    </div>
  </details>
</li>

<script>
  function initActivityCards() {
    document.querySelectorAll('[data-activity-card]').forEach((card) => {
      if (card.getAttribute('data-activity-ready') === 'true') return;
      card.setAttribute('data-activity-ready', 'true');

      card.querySelectorAll('[data-parking-mapcode]').forEach((copyButton) => {
        copyButton.addEventListener('click', async () => {
          const code = copyButton.getAttribute('data-parking-mapcode') || '';
          if (!code) return;
          try {
            await navigator.clipboard.writeText(code);
            const label = copyButton.textContent;
            copyButton.textContent = '✓ Copiado';
            window.setTimeout(() => { copyButton.textContent = label; }, 1600);
          } catch {
            // Seleccionar manualmente el código visible cuando el portapapeles no esté disponible.
            copyButton.textContent = 'Selecciona el MAPCODE visible';
          }
        });
      });
      const id = card.getAttribute('data-activity-id');
      const bathSelector = card.querySelector('[data-bath-selector]');
      if (id && bathSelector instanceof HTMLElement) {
        const choiceButtons = Array.from(bathSelector.querySelectorAll('[data-bath-choice]'));
        const panels = Array.from(bathSelector.querySelectorAll('[data-bath-panel]'));
        const ids = choiceButtons.map((el) => el.getAttribute('data-bath-choice'));
        const bathKey = `japon2026:bath-option:${id}`;
        const defaultChoice = bathSelector.getAttribute('data-default-option') || '';
        let savedChoice = defaultChoice;
        try {
          const selected = localStorage.getItem(bathKey);
          if (selected && ids.includes(selected)) savedChoice = selected;
        } catch {}
        function chooseBath(choice) {
          choiceButtons.forEach((b) => {
            const selected = b.getAttribute('data-bath-choice') === choice;
            b.setAttribute('aria-pressed', String(selected));
            b.classList.toggle('bg-slate-950', selected);
            b.classList.toggle('border-slate-950', selected);
            b.classList.toggle('text-white', selected);
            b.classList.toggle('bg-slate-50', !selected);
            b.classList.toggle('border-slate-200', !selected);
            b.classList.toggle('text-slate-700', !selected);
          });
          panels.forEach(p => p.classList.toggle('hidden', p.getAttribute('data-bath-panel') !== choice));
        }
        chooseBath(savedChoice);
        choiceButtons.forEach(b => b.addEventListener('click', () => {
          const choice = b.getAttribute('data-bath-choice') || defaultChoice;
          chooseBath(choice);
          try { localStorage.setItem(bathKey, choice); } catch {}
          bathSelector.querySelector('[data-bath-saved]')?.classList.remove('hidden');
          document.dispatchEvent(new CustomEvent('japon2026:bath-choice', { detail: { id, choice } }));
        }));
      }
      const choiceSelector = card.querySelector('[data-choice-selector]');
      if (id && choiceSelector instanceof HTMLElement) {
        const choiceButtons = Array.from(choiceSelector.querySelectorAll('[data-choice]'));
        const choicePanels = Array.from(choiceSelector.querySelectorAll('[data-choice-panel]'));
        const choiceIds = choiceButtons.map((el) => el.getAttribute('data-choice'));
        const choiceKey = `japon2026:choice:${id}`;
        const defaultOption = choiceSelector.getAttribute('data-default-option') || '';
        let initialChoice = defaultOption;
        try {
          const stored = localStorage.getItem(choiceKey);
          // IDs antiguos o borrados caen al valor por defecto.
          if (stored && choiceIds.includes(stored)) initialChoice = stored;
        } catch {}
        const enc = encodeURIComponent;
        function applyChoice(choice) {
          let chosen = null;
          choiceButtons.forEach((b) => {
            const on = b.getAttribute('data-choice') === choice;
            if (on) chosen = b;
            b.setAttribute('aria-pressed', String(on));
            b.classList.toggle('bg-slate-950', on);
            b.classList.toggle('border-slate-950', on);
            b.classList.toggle('text-white', on);
            b.classList.toggle('bg-white', !on);
            b.classList.toggle('border-orange-200', !on);
            b.classList.toggle('text-slate-700', !on);
          });
          choicePanels.forEach(p => p.classList.toggle('hidden', p.getAttribute('data-choice-panel') !== choice));
          if (!chosen) return;
          const q = chosen.getAttribute('data-choice-query') || '';
          const name = chosen.getAttribute('data-choice-name') || '';
          const current = card.querySelector('[data-choice-current]');
          if (current) current.textContent = '➜ ' + name;
          card.setAttribute('data-activity-query', q);
          const links = {
            maps: `https://www.google.com/maps/search/?api=1&query=${enc(q)}`,
            dir: `https://www.google.com/maps/dir/?api=1&destination=${enc(q)}`,
            apple: `https://maps.apple.com/?q=${enc(q)}`,
            tabelog: `https://tabelog.com/en/rstLst/?vs=1&sk=${enc(q)}`,
          };
          card.querySelectorAll('[data-choice-link]').forEach((a) => {
            const kind = a.getAttribute('data-choice-link');
            if (kind && links[kind]) a.setAttribute('href', links[kind]);
          });
        }
        applyChoice(initialChoice);
        choiceButtons.forEach(b => b.addEventListener('click', () => {
          const choice = b.getAttribute('data-choice') || defaultOption;
          applyChoice(choice);
          try { localStorage.setItem(choiceKey, choice); } catch {}
          document.dispatchEvent(new CustomEvent('japon2026:choice', { detail: { id, choice } }));
        }));
      }
      const button = card.querySelector('[data-complete-toggle]');

      const note = card.querySelector('[data-personal-note]');
      const noteSaved = card.querySelector('[data-note-saved]');
      if (!id || !(button instanceof HTMLButtonElement)) return;

      const key = `japon2026:activity-done:${id}`;
      const noteKey = `japon2026:activity-note:${id}`;

      function apply(done) {
        card.setAttribute('data-completed', done ? 'true' : 'false');


        button.textContent = done ? '↩ Marcar como pendiente' : '✓ Marcar como hecho';
      }

      // Las visitas confirmadas por el usuario cuentan como realizadas por defecto.
      // Una marca manual previa en este dispositivo prevalece.
      let done = card.getAttribute('data-completed') === 'true';
      try {
        const stored = localStorage.getItem(key);
        if (stored !== null) done = done || stored === 'true'; // hecho real canónico no vuelve a pendiente por caché antigua
      } catch {}
      apply(done);

      if (note instanceof HTMLTextAreaElement) {
        try { note.value = localStorage.getItem(noteKey) ?? ''; } catch {}
        let saveTimer;
        note.addEventListener('input', () => {
          window.clearTimeout(saveTimer);
          saveTimer = window.setTimeout(() => {
            try { localStorage.setItem(noteKey, note.value); } catch {}
            noteSaved?.classList.remove('hidden');
            window.setTimeout(() => noteSaved?.classList.add('hidden'), 1200);
          }, 250);
        });
      }

      button.addEventListener('click', () => {
        const next = card.getAttribute('data-completed') !== 'true';
        try { localStorage.setItem(key, next ? 'true' : 'false'); } catch {}
        apply(next);
        document.dispatchEvent(new CustomEvent('japon2026:activity-state'));
      });
    });
  }

  initActivityCards();
  document.addEventListener('astro:page-load', initActivityCards);
</script>

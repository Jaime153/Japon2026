---
import { CATEGORY_META, STATUS_META } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

type Activity = CollectionEntry<'segments'>['data']['days'][number]['activities'][number];
interface Props { activity: Activity; compact?: boolean; }

const { activity, compact = false } = Astro.props;
const meta = CATEGORY_META[activity.category];
const status = STATUS_META[activity.status];
const query = activity.locationQuery ?? activity.address ?? activity.title;
const googleMapsUrl = activity.links?.googleMaps ?? (query ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}` : undefined);
const appleMapsUrl = activity.links?.appleMaps ?? (query ? `https://maps.apple.com/?q=${encodeURIComponent(query)}` : undefined);
const directionsUrl = query ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(query)}` : undefined;
const tabelogUrl = activity.links?.tabelog ?? (activity.category === 'comida'
  ? `https://tabelog.com/en/rstLst/?vs=1&sk=${encodeURIComponent(activity.title)}`
  : undefined);
---

<li
  class:list={['activity-card rounded-2xl border bg-white shadow-sm', compact ? 'p-3' : 'p-4', activity.priority === 'must' ? 'border-red-200 ring-1 ring-red-100' : 'border-slate-200']}
  data-activity-card
  data-activity-id={activity.id}
  data-activity-title={activity.title}
  data-activity-time={activity.time ?? ''}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class:list={['inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold', meta.className]}>{meta.icon} {meta.label}</span>
        <span class:list={['inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold', status.className]}>{status.label}</span>
        {activity.priority === 'must' && <span class="inline-flex rounded-full bg-red-600 px-2 py-0.5 text-[11px] font-semibold text-white">Sí o sí</span>}
      </div>
      <h3 class="mt-2 font-semibold leading-snug text-slate-950">{activity.title}</h3>
    </div>
    {activity.time && <span class="shrink-0 rounded-lg bg-slate-950 px-2 py-1 text-sm font-bold text-white">{activity.time}</span>}
  </div>

  {activity.notes && <p class="mt-2 text-sm leading-relaxed text-slate-600">{activity.notes}</p>}

  {(activity.address || activity.nearestStation || activity.duration || activity.approximatePrice || activity.reservationRequired) && (
    <dl class="mt-3 grid gap-1 text-xs text-slate-500">
      {activity.address && <div><dt class="sr-only">Dirección</dt><dd>📌 {activity.address}</dd></div>}
      {activity.nearestStation && <div><dt class="sr-only">Estación</dt><dd>🚉 {activity.nearestStation}</dd></div>}
      {activity.duration && <div><dt class="sr-only">Duración</dt><dd>⏱️ {activity.duration}</dd></div>}
      {activity.approximatePrice && <div><dt class="sr-only">Precio</dt><dd>💴 {activity.approximatePrice}</dd></div>}
      {activity.reservationRequired && <div class="font-semibold text-amber-700">⚠️ Reserva/entrada necesaria</div>}
    </dl>
  )}

  {(googleMapsUrl || appleMapsUrl || directionsUrl || tabelogUrl || activity.links?.officialWebsite || activity.links?.reservation || activity.links?.weather || activity.links?.liveCam) && (
    <div class="mt-3 flex flex-wrap gap-2">
      {googleMapsUrl && <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-800">📍 Google Maps</a>}
      {directionsUrl && <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800">🧭 Cómo llegar</a>}
      {appleMapsUrl && <a href={appleMapsUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-800"> Maps</a>}
      {tabelogUrl && <a href={tabelogUrl} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-orange-50 px-3 py-2 text-sm font-semibold text-orange-800">🍽️ Tabelog</a>}
      {activity.links?.officialWebsite && <a href={activity.links.officialWebsite} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-violet-50 px-3 py-2 text-sm font-semibold text-violet-800">🌐 Web oficial</a>}
      {activity.links?.reservation && <a href={activity.links.reservation} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900">🎫 Reservar</a>}
      {activity.links?.weather && <a href={activity.links.weather} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-900">🌤️ Previsión</a>}
      {activity.links?.liveCam && <a href={activity.links.liveCam} target="_blank" rel="noopener noreferrer" class="tap-target inline-flex items-center gap-1 rounded-xl bg-cyan-50 px-3 py-2 text-sm font-semibold text-cyan-900">📷 Fuji en directo</a>}
    </div>
  )}
</li>

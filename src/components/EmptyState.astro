---
interface Props {
  message?: string;
}

const { message = 'En planificación' } = Astro.props;
---

<div class="flex flex-col items-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
  <span class="text-3xl" aria-hidden="true">🧭</span>
  <p class="text-lg font-semibold text-slate-700">{message}</p>
  <p class="max-w-sm text-sm text-slate-500">
    Todavía no hay itinerario detallado para este tramo. Se irá completando más adelante.
  </p>
</div>
